  "L0_base": {
    "_comment": "条目切分，id=卷-序号",
    "items": [
      {"item_id": "01-001", "section": "谱系", "heading": "宗人府沿革", "original_lines": [94], "original": "国初置大宗正院正一品衙门洪武二十二年改院为府设宗人令左右宗正左右宗人职专玉牒谱系之事初以亲王领谱事后但以勲戚大臣掌之而不备官永乐七年迁都于北置行在宗人府十八年除行在二字洪熈元年复称行在正统六年复除之以本府所领系宗室重事故品秩特崇序列于文职衙门之首"},
      {"item_id": "01-002", "section": "谱系", "heading": "皇明祖训·立宗正院", "original_lines": [96], "original": "凡立宗正院以亲王长者主领院事以次官员皆用勲旧大臣专领玉牒谱系辨其亲踈敦睦皇族凡宗室有所陈请即为上闻听天子命"},
      {"item_id": "01-003", "section": "谱系", "heading": "皇明祖训·各王拟名二十字", "original_lines": [97,98,99,100,101,102,103,104,105,106,107,108,109,110,111,112,113,114,115,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133,134,135,136,137,138,139,140,141,142,143,144,145,146,147,148,149,150], "original": "凡东宫亲王位下各拟名二十字...靖江王位下 賛佐相规约经邦任履亨若依纯一行逺得袭芳名"},
      {"item_id": "01-004", "section": "谱系", "heading": "郡王子孙任用", "original_lines": [151], "original": "凡郡王子孙有文武材能堪任用者大宗正院具以名闻朝廷考验换授官职其陞转如常选法如或有犯宗正院取问明白具实闻奏轻则量罪降等重则黜为庶人但明赏罚不加刑责"},
      {"item_id": "01-005", "section": "事例", "heading": "新生子女奏报", "original_lines": [153], "original": "凡各王府有新生子女具生年月日并分嫡庶及生母姓氏奏报本府抄出附注宗支簿籍"},
      {"item_id": "01-006", "section": "事例", "heading": "请封袭封奏报", "original_lines": [154], "original": "凡各王府亲王郡王将军中尉诸名请封袭封及出阁新封郡主县主郡君县君乡君并薨故等项奏报本府抄出亦各附注宗支簿籍"},
      {"item_id": "01-007", "section": "事例", "heading": "附注簿籍礼部行查", "original_lines": [155], "original": "凡各项附注簿籍俱备礼部行查及验玉牒文册相同囘报施行"},
      {"item_id": "01-008", "section": "事例", "heading": "亲王未之国除授长史", "original_lines": [156], "original": "凡亲王未之国除授长史等官吏部行本府转行各府长史司取具到任日期及啓王知会"},
      {"item_id": "01-009", "section": "事例", "heading": "禄米与仪卫司", "original_lines": [157], "original": "凡各王府奏请禄米户部行本府查勘相同囘报施行凡亲王出府兵部奏拨仪卫司羣牧所等衙门官军旗校人等随侍行本府转送各长史司啓王知会在外无行"},
      {"item_id": "01-010", "section": "事例", "heading": "出阁房屋工部转行", "original_lines": [158], "original": "凡各王府有郡军中尉及郡主县主郡君县君乡君出阁起造房屋奏行工部转行本府查勘相同囘报施行"},
      {"item_id": "01-011", "section": "事例", "heading": "仪宾门籍与玉牒十年纂修", "original_lines": [159], "original": "凡在京郕府秀府仪宾朝参俱由本府带注门籍凡玉牒翰林院每十年一次纂修本府具各王府宗支开报"},
      {"item_id": "01-012", "section": "事例", "heading": "玉牒纸劄沿革", "original_lines": [160], "original": "凡玉牒纸劄永乐二十二年奏准于司礼监闗领表背匠工部取用洪熈元年奏准行司礼监别造纸劄翰林院委官一员公同附注宣徳三年奏准本府附写玉牒用翰林院官一员同本府经歴于史馆内附写"},
      {"item_id": "01-013", "section": "事例", "heading": "本府纸劄", "original_lines": [161], "original": "凡本府合用纸劄弘治十年奏准于刑部闗领印色顺天府买办"},
      {"item_id": "01-014", "section": "事例", "heading": "附注宗支吏员", "original_lines": [162], "original": "凡附注宗支弘治十年奏准吏部拨办事吏三名本府印信于承差内选补知印一名"},
      {"item_id": "01-015", "section": "南京宗人府", "heading": "南京宗人府沿革", "original_lines": [164], "original": "南京在洪武间为京师自永乐定都于北因名南京官署并置在南京者加南京二字今朝廷政令皆自京师出以逹于南京故以南京宗人府次宗人府诸衙门皆然其事例与在京衙门不同者各列于后"},
      {"item_id": "01-016", "section": "南京事例", "heading": "永乐十八年改南京宗人府", "original_lines": [166], "original": "永乐十八年改本府为南京宗人府不复降印惟改降经歴司印与南京各衙门行移"},
      {"item_id": "01-017", "section": "南京事例", "heading": "正门中门", "original_lines": [167], "original": "凡本府正门及中门以洪武间亲王曾掌府事至今官员人等不敢正门而坐中门出入"}
    ]
  },

