  "L5_NAM": {
    "_comment": "名录：各王府拟名二十字",
    "nam_id": "NAM-001",
    "item_id": "01-003",
    "name": "东宫亲王位下拟名二十字",
    "entries": [
      {"prince": "东宫位下（帝系）", "chars": "允文遵祖训 钦武大君胜 顺道宜逢吉 师良善用晟"},
      {"prince": "秦王位下", "chars": "尚志公诚秉 惟怀敬谊存 辅嗣资廉直 匡时永信惇"},
      {"prince": "晋王位下", "chars": "济美钟奇表 知新慎敏求 审心咸景慕 述学继前修"},
      {"prince": "燕王位下（今为帝系）", "chars": "高瞻祁见祐 厚载翊常由 慈和怡伯仲 简靖迪先猷"},
      {"prince": "周王位下", "chars": "有子同安睦 勤朝在肃恭 绍伦敷惠泽 昭恪广登庸"},
      {"prince": "楚王位下", "chars": "孟季均荣显 英华蕴盛容 宏才升博衍 茂士立全功"},
      {"prince": "齐王位下", "chars": "贤能长可庆 睿智实堪宗 养性期渊雅 寅思复会通"},
      {"prince": "潭王位下", "chars": "福昌忻保定 嘉应必兴隆 启处询从式 尊闻汝贵中"},
      {"prince": "鲁王位下", "chars": "肇泰阳当健 观颐寿以弘 振举希兼达 康庄遇本宁"},
      {"prince": "蜀王位下", "chars": "悦友申宾让 承宣奉至平 懋进深滋益 端居务穆清"},
      {"prince": "湘王位下", "chars": "久镇开方岳 扬威谨礼仪 刚毅循超卓 权衡素自持"},
      {"prince": "代王位下", "chars": "逊仕成聪俊 充廷鼐鼎彝 传贻连秀郁 炳燿壮洪基"},
      {"prince": "肃王位下", "chars": "赡禄贡真弼 缙绅识烈忠 曦晖跻富运 凯谏处恒隆"},
      {"prince": "辽王位下", "chars": "贵豪恩宠致 宪术俨尊儒 云仍祺保合 操翰丽龙舆"},
      {"prince": "庆王位下", "chars": "秩邃寘台鼒 倪伸帅倬奇 适完因巨衍 骘眷发需毗"},
      {"prince": "宁王位下", "chars": "磐奠觐宸拱 多谋统议中 总添支庶阔 作哲向亲衷"},
      {"prince": "岷王位下", "chars": "徽音膺彦誉 定干企禋雍 崇理原咨访 宽镕喜贲从"},
