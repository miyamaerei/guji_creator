# ============================================================
#  guji_creator —— 统一忽略规则
#
#  唯一原则：只入仓「丢了就再也拿不回来的东西」
#    收：脚本 .py / 手写或 AI 产出的源数据（_src/、sources/、*_ai_NN.py）
#        文档 .md / 口径规范 / 复盘与总结 / 条目指纹库 _item_registry.json
#    丢：一切能靠 build_*.py 重跑出来的中间产物、缓存、备份、压缩包
#
#  注：gitignore 不支持行尾注释，注释必须独占一行。
#      子项目里若还有各自的 .gitignore（如 wuzazu-kb/），以本文件为准。
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.log

# ---------- 临时 / 备份 / 单轮调试残留 ----------
*.bak
*.orig
*.tmp
_tmp*/
_tmp_*/
_backup*/
_backup_*/
_legacy/
.dumate/
_selftest_last.txt
_tmp_*.txt
_tmp_*.json

# ---------- 机器产物：底座切分（build_base.py 可重建）----------
_extract/

# ---------- 机器产物：分层打包 / 汇总 / 校验 ----------
_layers/
_build/
_validate/

# 水东日记：各 build_*.py 的打包产物目录
data/

# 水东日记：按层聚合出的巨量 JSON / CSV
层聚合/

# ---------- 机器产物：跨层聚合与归一汇总（体积大、可重建）----------
_kg_join.json
_kg_join_index.json
_kg_[0-9][0-9].json
_trl_[0-9][0-9].json
归一_*.json
trl_汇总.json
trl_卷[0-9][0-9]_全书记译.txt

# ---------- 交付物里的打包副本与压缩包（可重建且体积大）----------
*.zip
*_global_layers/

# ---------- 阅读器 / 导出物（可重建）----------
_shots/
**/新官轨范_阅读器/raw/
*.epub
