# ---------- 联邦库（可重建派生库，不入仓）----------
tools/kb-federation/*.sqlite
tools/kb-federation/*.sqlite.bak_*

# ============================================================
#  guji_creator —— 统一忽略规则
#
#  唯一原则：只入仓「丢了就再也拿不回来的东西」
#    收：脚本 .py / 手写或 AI 产出的源数据（_src/、sources/、*_ai_NN.py）
#        文档 .md / 口径规范 / 复盘与总结 / 条目指纹库 _item_registry.json
#    丢：一切能靠 build_*.py 重跑出来的中间产物、缓存、备份、压缩包
#
#  注：gitignore 不支持行尾注释，注释必须独占一行。
#      子项目里若还有各自的 .gitignore（如 wuzazu-kb/），以本文件为准。
# ============================================================

# ---------- 工具私有目录 ----------
.workbuddy/
.workbuddy-ai/

# ---------- 原书正文 / 源数据 ----------
# 体积大且涉整理者署名与版权，一律不入库；
# 各项目 <根>/_source/ 下放源文本即可被脚本自动找到（也可用环境变量覆盖）。
# 只保留 _source/README.md 作为放置说明。
**/_source/**
!**/_source/README.md

# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.log

# ---------- 临时 / 备份 / 单轮调试残留 ----------
*.bak
*.orig
*.tmp
_tmp*/
_tmp_*/
_backup*/
_backup_*/
_legacy/
.dumate/
_selftest_last.txt
_tmp_*.txt
_tmp_*.json
_tmp_*
# 单轮调试残留：_pb.py / _q5.txt / _p39.txt 一类根级散落脚本与探针输出
/_*.py
/_*.txt
/_*.json
# 冒烟/临时探针脚本（各书工程内的 _scratch_*、_probe* 等）
_scratch_*
_probe*
# sqlite 备份命名变体（bak 用 '-' 分隔时 *.sqlite.bak_* 规则漏网）
*.sqlite.bak-*
*.sqlite.bak-*/
# 根级空 sqlite 占位
/kb.sqlite
# 多轮对话临时启动标记
/billion-context-start.json
# DSH 内部结构一次性探针（asar 扫描，用完即弃）
asar-scan*.mjs
asal-scan*.mjs

# ---------- 机器产物：底座切分（build_base.py 可重建）----------
_extract/

# ---------- 机器产物：分层打包 / 汇总 / 校验 ----------
_layers/
_build/
_validate/

# 水东日记：各 build_*.py 的打包产物目录
data/

# 水东日记：按层聚合出的巨量 JSON / CSV
层聚合/

# ---------- 机器产物：跨层聚合与归一汇总（体积大、可重建）----------
_kg_join.json
_kg_join_index.json
_kg_[0-9][0-9].json
_trl_[0-9][0-9].json
归一_*.json
trl_汇总.json
trl_卷[0-9][0-9]_全书记译.txt

# ---------- 交付物里的打包副本与压缩包（可重建且体积大）----------
*.zip
*_global_layers/

# ---------- 阅读器 / 导出物（可重建）----------
_shots/
**/新官轨范_阅读器/raw/
*.epub

# ---------- 交付包内的自包含副本：明会典 _deliver 整包入库 ----------
# 上面的 _layers/ 与 _kg_join.json 是未锚定规则，会连带排除交付包内的数据副本；
# 此处显式取反，保证交付包开箱即用（数据源仍是各项目 _layers/，不入库）。
!/minghuidian/_deliver/
!/minghuidian/_deliver/**

# ---------- 万历野获编：派生视图库（build_views.py 全量重建，不入仓）----------
# build_views.py 第 24 行 VIEWS=views/、第 92-93 行 shutil.rmtree 后全量重写；
# 输入仅 _layers/ + _global/ + _item_registry.json，属纯派生产物。
wanliyehuopian-kb/*/views/

# ---------- 明一统志：旧分层快照备份（已被 _layers/ 取代，不入仓）----------
mingyitongzhi-kb/*/_layers_old/
