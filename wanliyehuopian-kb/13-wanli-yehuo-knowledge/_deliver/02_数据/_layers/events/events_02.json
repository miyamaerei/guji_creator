    {
      "event_id": "EVT-02-016",
      "item_id": "02-014",
      "type": "朝政",
      "who": "沈鲤",
      "who_ent_ids": [
        "ENT-4957",
        "ENT-4956"
      ],
      "action": "议崇祀陈献章于孔庙",
      "what": "今上甲申议崇祀陈献章於孔庙，礼臣沈鲤疑大榼张宏主之不肯行，内阁票发多官会议允祀，由是与政府不协",
      "when": "万历甲申",
      "where": "北京",
      "original": "其后，今上甲申议崇祀陈献章於孔庙。礼臣为沈鲤，亦疑大榼张宏主之，不肯行。而内阁竟票发多官，会议允祀，由是与政府不协",
      "event_significance": "一般掌故",
      "political_impact": "从祀之议引发内阁与礼臣不和",
      "source_type": "文献转引",
      "vs_official_history": "补正史之阙",
      "related_events": []
    },
    {
      "event_id": "EVT-02-017",
      "item_id": "02-020",
      "type": "朝政",
      "who": "世宗",
      "who_ent_ids": [
        "ENT-4961",
        "ENT-4964"
      ],
      "action": "定圣诞忌辰同日先祭后贺之仪",
      "what": "嘉靖三年遇圣诞，礼部汪文庄请即以是日先行孝慈奉祭礼然后嵩呼大庆，上允之，四十余年不复辍",
      "when": "嘉靖三年",
      "where": "北京",
      "original": "至嘉靖三年，又遇圣诞，时礼部为汪文庄，请即以是日先行孝慈奉祭礼，然后嵩呼大庆，一切如先朝故事。上允之，四十余年不复辍",
      "event_significance": "制度变动",
      "political_impact": "定忌辰圣诞同日先行祭后贺之制",
      "source_type": "文献转引",
      "vs_official_history": "补正史之阙",
      "related_events": []
    },
    {
      "event_id": "EVT-02-018",
      "item_id": "02-023",
      "type": "文化",
      "who": "潘渊",
      "who_ent_ids": [
        "ENT-4966"
      ],
      "action": "进嘉靖龙飞颂",
      "what": "天台知县潘渊进嘉靖《龙飞颂》内外六十四图凡五百段一万二千章，上命开写正文再上，不闻赏罚",
      "when": "嘉靖四年",
      "where": "北京",
      "original": "如嘉靖四年，天台知县潘渊，进嘉靖《龙飞颂》，内外六十四图，凡五百段，一万二千章，效苏蕙织锦回文体以献，其用心亦勤矣。上以其文字纵横，不可辨识，命开写正文再上之。然其时不闻有赏，尚不闻被罚也",
      "event_significance": "轶闻",
      "political_impact": "献颂不赏不罚",
      "source_type": "文献转引",
      "vs_official_history": "正史不载",
      "related_events": []
    },
    {
      "event_id": "EVT-02-019",
      "item_id": "02-023",
      "type": "司法",
      "who": "张振通",
      "who_ent_ids": [
        "ENT-4967"
      ],
      "action": "献中兴颂诗获谴",
      "what": "朝天宫道士张振通进献中兴颂诗等，诏下法司逮击讯问",
      "when": "嘉靖十三年",
      "where": "北京",
      "original": "至嘉靖十三年，朝天宫道士张振通奏：“臣祝釐之暇，作《中兴颂》诗二十一首，金台八景，武夷九曲，皇陵八咏，以及瑞露、白鹊、白兔，俱有诗上进。乞赐宸翰序文。”下部议，以猥鄙陈渎，替逾狂悖，希图进用，诏下法司逮击讯问",
      "event_significance": "一般掌故",
      "political_impact": "进谀希恩反得谴",
      "source_type": "文献转引",
      "vs_official_history": "正史不载",
      "related_events": []
    },
    {
      "event_id": "EVT-02-020",
      "item_id": "02-023",
      "type": "司法",
      "who": "陈棐",
      "who_ent_ids": [
        "ENT-4968"
      ],
      "action": "衍敕谕为箴诗获谴",
      "what": "给事中陈棐将敕谕衍作箴诗十章上之，上大怒谓其上同天语，令自陈状后降调外任",
      "when": "嘉靖二十六年",
      "where": "北京",
      "original": "而给事中陈棐者，将敕谕衍作箴诗十章上之，上大怒，谓棐舞文墨，辄欲将此上同天语，风示在外臣工，甚为狂僭。令自陈状，棐服罪，乃降调外任",
      "event_significance": "一般掌故",
      "political_impact": "逢君求荣反得辱",
      "source_type": "文献转引",
      "vs_official_history": "正史不载",
      "related_events": []
    },
    {
      "event_id": "EVT-02-021",
      "item_id": "02-023",
      "type": "人事",
      "who": "夏言",
      "who_ent_ids": [
        "ENT-4969"
      ],
      "action": "进天赐时玉赋得褒入相",
      "what": "乙未春正月朔大雪，礼卿夏言进《天赐时玉赋》，上大悦以忠爱褒之，甫逾年而入相",
      "when": "嘉靖乙未",
      "where": "北京",
      "original": "然前此乙未年春正月朔大雪，上谕大臣曰：“今日欲与卿等一见，但蒙天赐时玉耳。”礼卿夏言。即进《天赐时玉赋》以献，上大悦，以忠爱褒之，甫逾年而入相矣",
      "event_significance": "人物转折",
      "political_impact": "夏言以献赋得入相",
      "source_type": "文献转引",
      "vs_official_history": "补正史之阙",
      "related_events": []
    },
    {
