        "ENT-4971"
      ],
      "action": "请增建庙制伦次被斥",
      "what": "尚宾司丞舆请增建庙制伦次绘图上之，意在尊睿宗，上不悦下法司鞫之，特命冠带闲住",
      "when": "嘉靖中",
      "where": "北京",
      "original": "嘉靖中，太庙被灾，寻即鼎建，时，尚宾司丞舆首上议，请增建庙制伦次，绘图上之，其意在尊睿宗也。上不悦，下法司鞫之，拟以纳赎还职，上特命冠带闲住",
      "event_significance": "一般掌故",
      "political_impact": "献谄增庙制者被斥闲住",
      "source_type": "文献转引",
      "vs_official_history": "正史不载",
      "related_events": []
