      "item_id": "02-014",
      "type": "朝政",
      "who": "张槚",
      "who_ent_ids": [
        "ENT-4953",
        "ENT-4954"
      ],
      "action": "奏请恢复太祖殿名",
      "what": "御史张槚请改仍太祖旧号，大宗伯高仪以皇考所定且遗诏不及殿名，乞存三年无改之义，遂不果易",
      "when": "隆庆初元",
      "where": "北京",
      "original": "至隆庆初元，而御史张槚请改仍太祖旧号。时，高仪为大宗伯，以为皇考所定，且遗诏中多所改正，独不及殿名，乞存之，以存“三年无改”之义。遂不果易",
      "event_significance": "一般掌故",
      "political_impact": "殿名复旧之议被搁置",
      "source_type": "文献转引",
      "vs_official_history": "正史不载",
      "related_events": []
    },
    {
