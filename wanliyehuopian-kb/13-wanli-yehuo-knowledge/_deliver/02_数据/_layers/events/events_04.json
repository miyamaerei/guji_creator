    {
      "event_id": "EVT-04-010",
      "item_id": "04-010",
      "type": "朝政",
      "who": "世宗",
      "who_ent_ids": [
        "ENT-5104",
        "ENT-5105",
        "ENT-5106"
      ],
      "action": "幸承天府诸王迎谒",
      "what": "嘉靖十八年世宗幸承天府，先敕谕路近王府封疆者出城候驾跪迎道傍，驾至行殿行五拜三叩头礼，赵王迎于磁州汝王迎于卫辉郑王迎于新郑周世孙迎于郑州徽王迎于钩州唐王迎于南阳府，俱宴赐有加",
      "when": "嘉靖十八年",
      "where": "承天府",
      "original": "惟嘉靖十八年，世宗幸承天府，先敕谕路近王府封疆者，出城候驾，跪迎道傍。驾至行殿，行五拜三叩头礼，于是赵王迎于磁州，汝王迎于卫辉，郑王迎于新郑，周世孙迎于郑州，徽王迎于所封钩州（今禹州），唐王迎于所封南阳府，俱宴赐有加，而朝宗王会之盛极矣",
      "event_significance": "一般掌故",
      "political_impact": "诸王迎驾朝宗王会之盛",
      "source_type": "文献转引",
      "vs_official_history": "补正史之阙",
      "related_events": []
    },
    {
      "event_id": "EVT-04-011",
      "item_id": "04-010",
      "type": "朝政",
      "who": "张居正",
      "who_ent_ids": [
        "ENT-5108",
        "ENT-5106",
        "ENT-5107"
      ],
      "action": "过南阳唐王出郊谒",
      "what": "万历六年故相江陵张公以葬父归过南阳，唐王出郊谒具宾主及答拜留款，张坐南面王相向讲敌礼；至襄阳府襄王亦仿唐例无少异",
      "when": "万历六年",
      "where": "南阳",
      "original": "至万历六年，故相江陵张公，以葬父归，过南阳，唐王出郊谒，具宾主，及答拜留款。张坐南面，王相向讲敌礼。至襄阳府，则襄王亦仿唐例无少异",
      "event_significance": "一般掌故",
      "political_impact": "亲藩以得亲奉謦欬为幸事",
      "source_type": "文献转引",
      "vs_official_history": "异于正史",
      "related_events": []
    },
    {
      "event_id": "EVT-04-012",
      "item_id": "04-020",
      "type": "朝政",
      "who": "世宗",
      "who_ent_ids": [
        "ENT-5114",
        "ENT-5112",
        "ENT-5115"
      ],
      "action": "追封岳怀王",
      "what": "嘉靖四年诏追封岳王谥曰怀，以章圣太后悼忆长子故上追崇，然竟无名可讳至三十九年始追赐今名",
      "when": "嘉靖四年",
      "where": "北京",
      "original": "若岳怀王厚熙，为兴献王之长子，世宗同母兄也，生仅五日而薨。嘉靖四年。诏追封岳王，谥曰怀。时章圣太后在养。悼忆长子，故上追崇，以上承慈意，不失为孝。然竟无名可讳，至三十九年，始追赐今名，亦异矣",
      "event_significance": "一般掌故",
      "political_impact": "追崇同母兄以承慈意",
      "source_type": "文献转引",
      "vs_official_history": "补正史之阙",
      "related_events": []
    },
    {
      "event_id": "EVT-04-013",
      "item_id": "04-020",
      "type": "朝政",
      "who": "世宗",
      "who_ent_ids": [
        "ENT-5114",
        "ENT-5116",
