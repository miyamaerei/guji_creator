    {
      "event_id": "EVT-05-017",
      "item_id": "05-016",
      "type": "社会",
      "who": "吴中",
      "who_ent_ids": [
        "ENT-5166"
      ],
      "action": "吴中畏内剧",
      "what": "永乐宣德间吴中为左都御史寻改刑工尚书至兼掌吏部加官至少保，其人好色多妾媵而妻严酷不敢近，禁中优人承应遂作《吴中畏内》一剧，上辄为一引满",
      "when": "永乐—宣德",
      "where": "北京",
      "original": "其人好色多妾媵，而妻严酷不敢近。一日，领诰命归，妻令左右读其词，因问中曰：“此果圣语耶？”中曰：“不过词臣代言耳。”妻曰：“此翰林真无忝清华，即吴中一诰，何尝以一廉字许之。”中惭笑而已。盖中素以墨著也。其后禁中优人承应，遂作《吴中畏内》一剧，上辄为一引满。此亦惧内之最享福泽者，附记为诸公解嘲",
      "event_significance": "轶闻",
      "political_impact": "优人作剧上为一引满",
      "source_type": "文献转引",
      "vs_official_history": "正史不载",
      "related_events": []
    },
    {
