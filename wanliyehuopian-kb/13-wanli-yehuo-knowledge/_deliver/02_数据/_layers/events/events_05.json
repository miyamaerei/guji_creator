      ],
      "action": "昌言当继故封",
      "what": "开国无勋如李韩公傅颍公俱以嫌死不及嗣爵，嘉靖间继绝世亦无敢议及者，近代王弇州始昌言当继故封自是公论",
      "when": "嘉靖—万历",
      "where": "北京",
      "original": "开国无勋，如李韩公、傅颍公，俱以嫌死，不及嗣爵。嘉靖间，继绝世，亦无敢议及者。近代王弇州，始昌言当继故封，自是公论",
      "event_significance": "一般掌故",
      "political_impact": "继绝世之议始自王世贞",
      "source_type": "文献转引",
      "vs_official_history": "补正史之阙",
      "related_events": []
    },
