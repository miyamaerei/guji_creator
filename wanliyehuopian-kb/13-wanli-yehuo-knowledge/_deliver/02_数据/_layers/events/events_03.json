    {
      "event_id": "EVT-03-011",
      "item_id": "03-007",
      "type": "边政",
      "who": "太祖",
      "who_ent_ids": [
        "ENT-5034",
        "ENT-5035"
      ],
      "action": "敕辽东备高丽",
      "what": "洪武十三年高丽愆贡期，上赐诏诘责，敕辽东都指挥使司备谊女在宫之疑，命遣谊来京别有以处之",
      "when": "洪武十三年",
      "where": "辽东",
      "original": "洪武十三年，高丽愆贡期，上赐诏诘责之。既而彼国遣使周谊来计事，上敕辽东都指挥使司曰：“高丽朝贡违约，朕拘其使，后纵之归，乃复怀诈，令谊作行人，非有谋而何？前元庚申君曾纳谊女于宫中，庚申君出奔，内臣得此女以归，今高丽数遣谊来使，殊有意焉，卿不可不备。敕至当遣谊来京，别有以处之。”",
      "event_significance": "重大政治",
      "political_impact": "以防女戎严敕边将",
      "source_type": "文献转引",
      "vs_official_history": "补正史之阙",
      "related_events": []
    },
    {
      "event_id": "EVT-03-012",
      "item_id": "03-007",
      "type": "边政",
      "who": "太祖",
      "who_ent_ids": [
        "ENT-5034"
      ],
      "action": "高丽入境者皆止于边",
      "what": "命边将自今入境者皆止于边不许入见，虽有贡赋亦不许入献",
      "when": "洪武十三年",
      "where": "辽东",
      "original": "仍命边将：“自今入境者，皆止于边，不许入见，虽有贡赋亦不许入献。”",
      "event_significance": "制度变动",
      "political_impact": "高丽贡使止于边不得入献",
      "source_type": "文献转引",
      "vs_official_history": "补正史之阙",
      "related_events": []
    },
    {
      "event_id": "EVT-03-013",
      "item_id": "03-011",
      "type": "宫廷",
      "who": "高皇帝",
      "who_ent_ids": [
        "ENT-5037"
      ],
      "action": "册李氏淑妃郭氏宁妃",
      "what": "洪武十七年甲子册李氏为皇淑妃，进封郭氏为皇宁妃，而贵妃反不得皇字",
      "when": "洪武十七年",
      "where": "大内",
      "original": "如高皇帝洪武十七年甲子，册李氏为皇淑妃，又进封郭氏为皇宁妃，而贵妃反不得“皇”字，此其异也",
      "event_significance": "一般掌故",
      "political_impact": "皇字未专属贵妃",
      "source_type": "文献转引",
      "vs_official_history": "补正史之阙",
      "related_events": []
    },
    {
      "event_id": "EVT-03-014",
      "item_id": "03-011",
      "type": "宫廷",
      "who": "世宗",
      "who_ent_ids": [
        "ENT-5041",
        "ENT-5040"
      ],
      "action": "追封荣妃杨氏",
      "what": "荣妃杨氏以宫人随上遭火灾而得追贲，谥以恭淑安僖四字，祔葬于孝洁皇后之侧",
      "when": "嘉靖中",
      "where": "大内",
      "original": "如追封荣妃杨氏，乃以宫人随上遭火灾而得追贲，且谥以恭淑安僖四字，且祔葬于孝洁皇后之侧。此殊特之典，又前此未有者",
      "event_significance": "一般掌故",
      "political_impact": "宫人追妃并四字谥",
      "source_type": "文献转引",
      "vs_official_history": "补正史之阙",
      "related_events": []
    },
    {
      "event_id": "EVT-03-015",
      "item_id": "03-011",
      "type": "宫廷",
      "who": "世宗",
      "who_ent_ids": [
        "ENT-5043",
        "ENT-5040"
      ],
      "action": "击磬误槌幼者承宠",
      "what": "世宗诵经运手击磬偶误槌他处，惟一幼者失声大笑，经辍后遂承更衣之宠，即尚美人，时年仅十三",
      "when": "嘉靖中",
      "where": "西宫",
      "original": "闻之老内侍云：世宗一日诵经，运手击磬，偶误槌他处，诸侍女皆俯首不敢仰，惟一幼者失声大笑。上注目顾之，咸谓命在顷刻矣。经辍后，遂承更衣之宠，即世所称尚美人是也。从此贵宠震天下，时年仅十三，世宗已将耳顺矣",
      "event_significance": "人物转折",
      "political_impact": "幼者以大笑承宠贵震天下",
      "source_type": "传闻",
      "vs_official_history": "正史不载",
      "related_events": []
    },
    {
      "event_id": "EVT-03-016",
      "item_id": "03-011",
      "type": "宫廷",
      "who": "世宗",
      "who_ent_ids": [
        "ENT-5044"
      ],
      "action": "册寿妃百余日上大渐",
      "what": "其后册拜为寿妃，拜后百余日而上大渐，寿妃之薨在万历三十八年庚戌",
      "when": "嘉靖末",
      "where": "大内",
      "original": "其后册拜为寿妃，拜后百余日，而上大渐。说者归罪寿妃，微似汉成帝之赵昭仪云。寿妃之薨，在万历三十八年庚戌。宫嫔承恩早，而下世晚者，近代少其比",
      "event_significance": "人物转折",
      "political_impact": "寿妃之宠与上大渐",
      "source_type": "文献转引",
      "vs_official_history": "正史不载",
      "related_events": []
    },
    {
      "event_id": "EVT-03-017",
      "item_id": "03-023",
      "type": "朝政",
      "who": "世宗",
      "who_ent_ids": [
        "ENT-5045",
        "ENT-5046",
        "ENT-5048"
      ],
      "action": "欲刊行女训内训",
      "what": "世宗以章圣太后所著《女训》示辅臣，复以《慈孝高皇后传》及仁孝皇后《内训》同示，欲与《女训》并刊行，张璁赞美请上御制跋语，奉旨允行",
      "when": "嘉靖中",
      "where": "北京",
      "original": "世宗以章圣太后所著《女训》一卷示辅臣，其首即献帝为之序，次即太后自序，为目十有二。已复以《慈孝高皇后传》及仁孝皇后《内训》同示，欲与《女训》并刊行。辅臣张璁赞美，请上御制跋语于后，已奉旨允行矣",
      "event_significance": "一般掌故",
      "political_impact": "女训内训得旨刊行",
      "source_type": "文献转引",
      "vs_official_history": "补正史之阙",
      "related_events": []
    },
    {
      "event_id": "EVT-03-018",
      "item_id": "03-023",
      "type": "朝政",
      "who": "桂萼",
      "who_ent_ids": [
        "ENT-5049"
      ],
      "action": "献谀请设官女学",
      "what": "次辅桂萼献谀谓宜仿古胎教选哲妇轮直，令两京布政司府州县各修官女学设庙奉先代女师之神，选行义父老掌其事每年十月开学十二月止",
      "when": "嘉靖中",
      "where": "北京",
      "original": "次辅桂萼复献谀，谓《女训》一书，臣拜观详味，知天启中兴，圣贤继出，胚胎于此矣。宜仿古胎教，妊子及月，将二南诗古诗编成简明说词，选哲妇十余人以备轮直，凡中宫图书花鸟寓目之物，尤当一一拣择。又令两京布政司府州县各修官女学，设庙奉先代女师之神；傍有廊，为习女工之所；中一堂，为听教之堂。选行义父老掌其事，每年十月开学，十二月止",
      "event_significance": "一般掌故",
      "political_impact": "迂诞不经之议",
      "source_type": "文献转引",
      "vs_official_history": "正史不载",
      "related_events": []
    },
    {
