    {
      "event_id": "EVT-03-020",
      "item_id": "03-023",
      "type": "文化",
      "who": "郑妃",
      "who_ent_ids": [
        "ENT-5050"
      ],
      "action": "重刊吕氏闺范作序启大狱",
      "what": "近年重刊《吕氏闺范》，翊坤宫郑妃作序，说者遂有僭逼之疑，致启大狱贻祸迄今未解",
      "when": "万历中",
      "where": "北京",
      "original": "近年重刊《吕氏闺范》，翊坤宫郑妃作序，凝其书仁孝后之《女诫》、章圣后之《女训》。说者遂有僭逼之疑，致启大狱，贻祸迄今未解",
      "event_significance": "重大政治",
      "political_impact": "闺范作序启大狱",
      "source_type": "文献转引",
      "vs_official_history": "补正史之阙",
      "related_events": []
    },
    {
      "event_id": "EVT-03-021",
      "item_id": "03-026",
      "type": "朝政",
      "who": "彭时",
      "who_ent_ids": [
        "ENT-5051",
        "ENT-5052",
        "ENT-5053",
        "ENT-5057",
        "ENT-5058"
      ],
      "action": "成化初议孝庄祔葬",
      "what": "葬嫡后于他所诚为悖谬，彭时商辂姚夔诸大臣回天，礼卿姚文敏疏以同尊并列毫无低昂婉劝，孝肃曲意勉从",
      "when": "成化初",
      "where": "北京",
      "original": "当时彭时、商辂、姚夔诸大臣，回天之力固伟矣，然礼卿姚文敏疏中云：“慈懿葬于左，皇太后万年后葬于右；慈懿今日祔于庙，皇太后他日亦祔于庙。同尊并列毫无低昂。”其词甚婉，故孝肃曲意勉从",
      "event_significance": "重大政治",
      "political_impact": "孝庄得祔葬祔庙",
      "source_type": "文献转引",
      "vs_official_history": "补正史之阙",
      "related_events": []
    },
    {
      "event_id": "EVT-03-022",
      "item_id": "03-026",
      "type": "朝政",
      "who": "孝宗",
      "who_ent_ids": [
        "ENT-5055",
        "ENT-5054"
      ],
      "action": "定一帝一后之制",
      "what": "弘治甲子孝肃始崩，孝宗以二后合葬为非礼，因玄宫先就无可奈何仍旧贯；祔庙一事刘健等引唐宋二后三后并尊旧事，上曰祖宗以来惟一帝一后，健等称诵赞决而祔庙之议遂定",
      "when": "弘治甲子",
      "where": "北京",
      "original": "至于祔庙一事，刘健等尚祖姚夔旧说，引唐宋二后三后并尊旧事，以待上之自裁。而上乃曰：“祖宗以来，惟一帝一后。今若并祔，乃从朕坏起。况孝穆为朕生母，尚祀于奉慈殿。”又有事须师古，末世鄙亵不足学之语。健等始称诵赞决，而祔庙之议遂定",
      "event_significance": "制度变动",
      "political_impact": "一帝一后永为后世法",
      "source_type": "文献转引",
      "vs_official_history": "补正史之阙",
      "related_events": []
    },
    {
      "event_id": "EVT-03-023",
      "item_id": "03-026",
      "type": "朝政",
      "who": "世宗",
      "who_ent_ids": [
        "ENT-5061",
        "ENT-5062"
      ],
      "action": "先祔孝烈后",
      "what": "世宗先祔孝烈后，宁非祧仁宗而不恤者，亦以一帝一后成规已定，恐他日身所并食者不为孝烈而为元配孝洁，故预为之谋",
      "when": "嘉靖中",
      "where": "北京",
      "original": "最后世宗先祔孝烈后，宁非祧仁宗而不恤者，亦以一帝一后成规已定，恐他日身所并食者不为孝烈，而为元配之孝洁，故预为之谋，其心苦矣",
      "event_significance": "一般掌故",
      "political_impact": "祔庙成规下的预谋",
