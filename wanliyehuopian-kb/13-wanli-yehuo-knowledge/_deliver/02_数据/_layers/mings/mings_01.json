      "where": "京师",
      "category": "制度",
      "first_person": false,
      "ref_events": [],
      "original": "世宗入缵，初拟绍治为号，而上不用…况“嘉靖”二字，王守仁已称示于所勒文矣",
      "reign_focus": "嘉靖",
      "firsthand_witness": "不详",
      "supplements_what": "改元之议与继统不继嗣之隐微，正史不载"
    },
    {
