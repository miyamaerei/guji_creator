      "where": "安陆州",
      "category": "制度",
      "first_person": false,
      "ref_events": [],
      "original": "肃皇帝从兴邸入缵，已升安陆州为承天府，最合古义",
      "reign_focus": "嘉靖",
      "firsthand_witness": "不详",
      "supplements_what": "潜藩升府之例，与宋秀州升嘉兴府、文皇改北平布政司为北京并论"
    },
    {
      "ming_id": "MING-01-023",
      "item_id": "01-017",
      "era": "正德十六年",
      "who": "朱厚熜",
      "who_ent_ids": [
