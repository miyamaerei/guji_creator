      "where": "京师",
      "category": "朝政",
      "first_person": false,
      "ref_events": [],
      "original": "英宗复辟，石亨辈俱武人，第取美名以彰天眷，岂能谛考",
      "reign_focus": "天顺",
      "firsthand_witness": "不详",
      "supplements_what": "天顺改元用字之疏，可与永乐、正德并观"
    },
