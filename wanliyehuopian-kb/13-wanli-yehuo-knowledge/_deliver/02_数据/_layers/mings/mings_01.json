    {
      "ming_id": "MING-01-007",
      "item_id": "01-006",
      "era": "万历年间",
      "who": "沈德符",
      "who_ent_ids": [
        "ENT-5199",
        "ENT-5200"
      ],
      "what": "论帝王御集当建阁收藏，历举宋制及本朝太祖宣宗御集",
      "when": "万历年间",
      "where": "京师",
      "category": "文化",
      "first_person": false,
      "ref_events": [],
      "original": "帝王御集，莫尊崇于赵宋。每一朝则建一阁庋之…本朝唯太祖高皇帝、宣宗章皇帝御集裒刻，尊藏禁中",
      "reign_focus": "跨朝",
      "firsthand_witness": "不详",
      "supplements_what": "历代御集收藏阁职制度，及其与唐宋雅称之关系"
    },
    {
      "ming_id": "MING-01-008",
      "item_id": "01-007",
      "era": "洪武元年",
      "who": "徐达",
      "who_ent_ids": [
        "ENT-5209",
        "ENT-5210"
      ],
      "what": "收故元秘阁图书典籍尽解金陵",
      "when": "洪武元年",
      "where": "金陵",
      "category": "文化",
      "first_person": false,
      "ref_events": [],
      "original": "国初克故元时，太祖命大将军徐达，收其秘阁所藏图书典籍，尽解金陵。又诏求民间遗书。时宋刻板本，有一书至十余部者",
      "reign_focus": "洪武",
      "firsthand_witness": "不详",
      "supplements_what": "国初收元秘阁书及诏求民间遗书事，正史未详其书目流传"
    },
    {
      "ming_id": "MING-01-009",
      "item_id": "01-007",
      "era": "正统十四年",
      "who": "火",
      "who_ent_ids": [
        "ENT-5212"
      ],
      "what": "南京所存内署诸书悉遭大火，宋元秘本一朝俱尽",
      "when": "正统十四年",
      "where": "南京",
      "category": "灾异",
      "first_person": false,
      "ref_events": [],
      "original": "至正统十四年英宗北狩，而南京所存内署诸书，悉遭大火，凡宋元以来秘本，一朝俱尽矣",
      "reign_focus": "正统",
      "firsthand_witness": "不详",
      "supplements_what": "南京内署藏书焚毁事，正史不载"
    },
    {
      "ming_id": "MING-01-010",
      "item_id": "01-008",
      "era": "洪武年间",
      "who": "朱元璋",
      "who_ent_ids": [
        "ENT-5218"
      ],
      "what": "定百官朝退赐食于廷之制",
      "when": "洪武年间",
      "where": "京师",
      "category": "制度",
      "first_person": false,
      "ref_events": [],
      "original": "太祖时，百官朝退，必赐食于廷。盖用法虽严，而驭臣有礼。且其时每日赐对无间寒暑，即恤劳亦宜然",
      "reign_focus": "洪武",
      "firsthand_witness": "不详",
      "supplements_what": "太祖赐食于廷之制及其与赐对之关系，正史未详"
    },
    {
      "ming_id": "MING-01-011",
      "item_id": "01-009",
      "era": "永乐九年",
      "who": "杨士奇",
      "who_ent_ids": [
        "ENT-5234",
        "ENT-5235"
      ],
      "what": "三度开局修定《太祖实录》，今所传本是也",
      "when": "永乐九年",
      "where": "京师",
      "category": "文化",
      "first_person": false,
      "ref_events": [],
      "original": "其后永乐九年复以为未善，更命姚广孝监修，总裁则杨士奇，今所传本是也。然前两番所修，则不及见矣",
      "reign_focus": "永乐",
      "firsthand_witness": "不详",
      "supplements_what": "《太祖实录》三修之经过及前两番所修不传，正史仅存最后定本"
    },
    {
      "ming_id": "MING-01-012",
      "item_id": "01-010",
      "era": "洪武三十一年八月",
      "who": "杨士奇",
      "who_ent_ids": [
        "ENT-5239"
      ],
      "what": "以江西处士充实录篡修官，历建文至宣德三朝预修实录",
      "when": "洪武三十一年八月",
      "where": "京师",
      "category": "文化",
      "first_person": false,
      "ref_events": [],
      "original": "惟洪武三十一年八月建文君新即位，征江西处士杨士奇充实录篡修官，至建文元年正月始大开局",
      "reign_focus": "建文",
      "firsthand_witness": "不详",
      "supplements_what": "国初实录修撰开局之始及篡修官之征用，正史未详其原委"
    },
    {
      "ming_id": "MING-01-013",
      "item_id": "01-010",
      "era": "洪武三十五年七月",
      "who": "叶仲惠",
      "who_ent_ids": [
        "ENT-5243",
        "ENT-5240"
      ],
      "what": "以修太祖录指斥靖难君臣为逆党，论死籍没",
      "when": "洪武三十五年七月",
      "where": "京师",
      "category": "朝政",
      "first_person": false,
      "ref_events": [],
      "original": "文皇新即位，以前任知府叶仲惠等修太祖录，指斥靖难君臣为逆党，论死籍没，本年十二月始命重修",
      "reign_focus": "永乐",
      "firsthand_witness": "不详",
      "supplements_what": "建文所修太祖实录获罪之由及论死籍没事，正史讳载"
    },
    {
      "ming_id": "MING-01-014",
      "item_id": "01-012",
      "era": "建文三年正月朔",
      "who": "建文帝",
      "who_ent_ids": [
        "ENT-5272",
        "ENT-5273"
      ],
      "what": "受凝命神宝，玺文十六字，告天地祖宗宣示远迩",
      "when": "建文三年正月朔",
      "where": "京师",
      "category": "制度",
      "first_person": false,
      "ref_events": [],
      "original": "至是功成，赐今名，告天地祖宗，宣示远迩。百官毕贺，大宴文武、四夷于奉天门。玺文曰“天命明德，表正万方，精一执中，宇宙永昌”，凡十六字",
      "reign_focus": "建文",
      "firsthand_witness": "不详",
      "supplements_what": "建文凝命神宝之文与受宝之礼，正史不载；今其宝亦为文皇所斥不用"
    },
    {
      "ming_id": "MING-01-015",
      "item_id": "01-012",
      "era": "本朝",
      "who": "朱元璋",
      "who_ent_ids": [
        "ENT-5268",
        "ENT-5270",
        "ENT-5269"
      ],
      "what": "定诸宝文字皆四字，赐守令则用敬天勤民之宝",
      "when": "本朝",
      "where": "京师",
      "category": "制度",
      "first_person": false,
      "ref_events": [],
      "original": "然其八字甚少，本朝诸宝皆四字，若敬宗庙，则以“皇帝尊亲”之宝；赐亲藩，则用“皇帝亲亲”之宝；赐守令，则用“敬天勤民”之宝；求经籍，则用“表章经史”之宝",
      "reign_focus": "跨朝",
      "firsthand_witness": "不详",
      "supplements_what": "本朝诸宝四字成文与颁用之对象，可与正史舆服志相参"
    },
    {
      "ming_id": "MING-01-016",
      "item_id": "01-013",
      "era": "万历十八年五月",
      "who": "谢杰",
      "who_ent_ids": [
        "ENT-5291",
        "ENT-5282"
      ],
      "what": "抗章议懿文太子寝园遣祭非礼，改遣南京五府佥书官行礼",
      "when": "万历十八年五月",
      "where": "京师",
      "category": "制度",
      "first_person": false,
      "ref_events": [],
      "original": "至万历十八年五月，太常少卿谢杰，始抗章议其非礼。上下部详议，始改遣南京五府佥书官行礼，似于祀典稍加隆重",
      "reign_focus": "万历",
      "firsthand_witness": "不详",
      "supplements_what": "懿文太子寝园祭礼之改定，及南太常寺道官行礼之旧例"
    },
    {
      "ming_id": "MING-01-017",
      "item_id": "01-013",
      "era": "弘治中",
      "who": "缪恭",
      "who_ent_ids": [
        "ENT-5293",
        "ENT-5282"
      ],
      "what": "上书请封建庶人之后为王以奉懿文祀，被囚兵马司而上不罪",
      "when": "弘治中",
      "where": "京师",
      "category": "朝政",
      "first_person": false,
      "ref_events": [],
      "original": "按宏治中台州人缪恭走京师，上书言六事，其一请封建庶人之后为王，以奉懿文祀。通政司大怒，谓为讨死，囚之兵马司，以其疏上。上不罪也",
      "reign_focus": "弘治",
      "firsthand_witness": "不详",
      "supplements_what": "弘治中缪恭上书请奉懿文祀事，正史不载"
    },
    {
      "ming_id": "MING-01-018",
      "item_id": "01-014",
      "era": "建文年间",
      "who": "建文",
      "who_ent_ids": [
        "ENT-5301",
        "ENT-5299"
      ],
      "what": "追谥兴宗、加隆祢庙，懿文园遂有九大祭之礼",
      "when": "建文年间",
      "where": "金陵",
      "category": "制度",
      "first_person": false,
      "ref_events": [],
      "original": "太祖一岁大祭者凡三，而懿文园则九大祭，不知何故。意者，建文追谥兴宗时，加隆祢庙，有此缛礼",
      "reign_focus": "建文",
      "firsthand_witness": "不详",
      "supplements_what": "懿文园九祭之由及东陵之称，正史不载"
    },
    {
      "ming_id": "MING-01-019",
      "item_id": "01-015",
      "era": "正统五年",
      "who": "杨应祥",
      "who_ent_ids": [
        "ENT-5310",
        "ENT-5309"
      ],
      "what": "自称建文帝自云南至广西，岑瑛送之京师，鞫实锢死锦衣狱",
      "when": "正统五年",
      "where": "思恩、京师",
      "category": "朝政",
      "first_person": false,
      "ref_events": [],
      "original": "《实录》则云：正统五年，有僧年九十余，自云南至广西，语人曰：我建文帝也…诣思恩自言，岑瑛送之京师。会官鞠之，其姓名为杨应祥，钧州人，洪武十七年度为僧",
      "reign_focus": "正统",
      "firsthand_witness": "不详",
      "supplements_what": "建文出亡再归之三说各异，实录所记为假托之僧，正史可考"
    },
    {
      "ming_id": "MING-01-020",
      "item_id": "01-015",
      "era": "正统四年",
      "who": "岑瑛",
      "who_ent_ids": [
        "ENT-5309",
        "ENT-5318",
        "ENT-5314"
      ],
      "what": "以弑贼功升田州府知府，仍管思恩州，其后思恩升府",
      "when": "正统四年",
      "where": "思恩、田州",
      "category": "边政",
      "first_person": false,
      "ref_events": [],
      "original": "至正统四年，瑛以弑贼功，升田州府知府，仍管思恩州（升府事，见正统四年十月，实录内可查）。瑛欲并有田州，与知府岑绍交恶。总兵官柳薄议升思恩为府，益以诸峒诏从之，寻改称军民府",
      "reign_focus": "正统",
      "firsthand_witness": "不详",
      "supplements_what": "思恩本以州改府甚明，可正薛应旂、王世贞两家之误"
    },
    {
      "ming_id": "MING-01-021",
      "item_id": "01-015",
      "era": "甲戌年",
      "who": "张居正",
      "who_ent_ids": [
        "ENT-5330",
        "ENT-5331"
      ],
      "what": "日讲奏对建文君出亡事，引云南邮壁题诗之说",
      "when": "甲戌年",
      "where": "京师",
      "category": "亲历见闻",
      "first_person": false,
      "ref_events": [],
      "original": "甲戌年，今上御日讲，问辅臣以建文君出亡事。张居正对曰：此事国史无考，但相传正统间于云南邮壁题诗，有“流落江湖数十秋”之句",
      "reign_focus": "万历",
      "firsthand_witness": "不详",
      "supplements_what": "对照《英录》所载杨应祥假托事，可知江陵所对非实"
    },
    {
      "ming_id": "MING-01-022",
      "item_id": "01-016",
      "era": "嘉靖年间",
      "who": "朱厚熜",
      "who_ent_ids": [
        "ENT-5337"
      ],
