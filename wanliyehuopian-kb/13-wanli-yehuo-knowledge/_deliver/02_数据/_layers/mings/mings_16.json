[
  {
    "ming_id": "MING-16-001",
    "item_id": "16-001",
    "text": "刻一印记曰天下一二三人",
    "type": "叙事",
    "reign": "嘉靖",
    "source": "16-001",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-002",
    "item_id": "16-007",
    "text": "旨下吏部议以土司额设定员且在任难以加升宜于本府量加俸级且著为例",
    "type": "部议",
    "reign": "嘉靖",
    "source": "16-007",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-003",
    "item_id": "16-011",
    "text": "至乙丑南宫上微闻挟书之弊始命添设御史二员专司搜检",
    "type": "特旨",
    "reign": "嘉靖",
    "source": "16-011",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-004",
    "item_id": "16-029",
    "text": "上俱命定为永制自此朱邸诸侯始以清流自奋",
    "type": "特旨",
    "reign": "万历",
    "source": "16-029",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-005",
    "item_id": "16-030",
    "text": "举人在籍作奸犯科无法惩创请将最不肖者勒停会试以示裁抑上允之",
    "type": "部议",
    "reign": "万历",
    "source": "16-030",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-006",
    "item_id": "16-033",
    "text": "请取北人为解者谓燕赵乃至尊丰镐不当使他方人得之上允其议且定为永制",
    "type": "特旨",
    "reign": "万历",
    "source": "16-033",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-007",
    "item_id": "16-005",
    "text": "命供事如故",
    "type": "特旨",
    "reign": "万历",
    "source": "16-005",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-008",
    "item_id": "16-006",
    "text": "璠后得恩宥授官仕至太常卿",
    "type": "叙事",
    "reign": "嘉靖",
    "source": "16-006",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-009",
    "item_id": "16-016",
    "text": "欲知座主山齐寿",
    "type": "诗句",
    "reign": "万历",
    "source": "16-016",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-010",
    "item_id": "16-031",
    "text": "众哗然有言前场七艺尽录坊刻自破承至结题不易一字",
    "type": "叙事",
    "reign": "万历",
    "source": "16-031",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-011",
    "item_id": "16-004",
    "text": "先是荧惑守文昌不移，司天者屡以为言，传入闱中，为之备",
    "type": "叙事",
    "reign": "正德",
    "source": "16-004",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-012",
    "item_id": "16-004",
    "text": "礼闱之遇灾，人知天顺癸未科",
    "type": "叙事",
    "reign": "天顺",
    "source": "16-004",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-013",
    "item_id": "16-010",
    "text": "唐舟中革除己卯乡试，永乐癸未复试，俱中第二名，次年甲申举进士",
    "type": "叙事",
    "reign": "永乐",
    "source": "16-010",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-014",
    "item_id": "16-010",
    "text": "唐亮因中永乐丁酉浙江乡试，次年戊戌成进士",
    "type": "叙事",
    "reign": "永乐",
    "source": "16-010",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-015",
    "item_id": "16-018",
    "text": "丙戌科王太仓主试立意以简劲风世故首袁公安",
    "type": "叙事",
    "reign": "万历",
    "source": "16-018",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-016",
    "item_id": "16-021",
    "text": "丙午科顺天第四名邹汝矿以割卷败露枷于礼部门",
    "type": "叙事",
    "reign": "万历",
    "source": "16-021",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-017",
    "item_id": "16-021",
    "text": "乙酉顺天之役无端累及史钶削籍张一桂沈思孝董裕俱外谪",
    "type": "叙事",
    "reign": "万历",
    "source": "16-021",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-018",
    "item_id": "16-024",
    "text": "至隆庆初元，胡坐前事及他不法，论重典",
    "type": "特旨",
    "reign": "隆庆",
    "source": "16-024",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-019",
    "item_id": "16-024",
    "text": "杨复官褒赠，录一孙名忠裕者为胄子",
    "type": "特旨",
    "reign": "隆庆",
    "source": "16-024",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-020",
    "item_id": "16-026",
    "text": "戊子春娄上王辰玉松江董元宰入都名噪一时士人皆以前茅让之",
    "type": "叙事",
    "reign": "万历",
    "source": "16-026",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-021",
    "item_id": "16-027",
    "text": "近年吴江沈珣侍御先以中书入阅《尚书》至己酉再入亦稀有之事",
    "type": "叙事",
    "reign": "万历",
    "source": "16-027",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-022",
    "item_id": "16-028",
    "text": "今年衡不投卷而去，宗浚投卷而不赴试，时论高其品",
    "type": "叙事",
    "reign": "万历",
    "source": "16-028",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-023",
    "item_id": "16-028",
    "text": "时衡父锡爵给假在家，上虚首揆召之而未至",
    "type": "叙事",
    "reign": "万历",
    "source": "16-028",
    "confidence": "high"
  },
  {
    "ming_id": "MING-16-024",
    "item_id": "16-034",
    "text": "至二月会试，遂有假元一事，假元则去秋应天所举也",
    "type": "叙事",
    "reign": "万历",
    "source": "16-034",
    "confidence": "high"
  }
]
