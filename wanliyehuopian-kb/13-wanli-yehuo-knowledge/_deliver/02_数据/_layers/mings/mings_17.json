    "reign": "洪武",
    "source": "17-001",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-002",
    "item_id": "17-002",
    "text": "以罪谪充军者名为恩军意以免死得戍当怀上恩",
    "type": "诏令",
    "reign": "洪武",
    "source": "17-002",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-003",
    "item_id": "17-006",
    "text": "搜河套复东胜未可轻议惟增兵守险可为远图",
    "type": "奏疏",
    "reign": "成化",
    "source": "17-006",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-004",
    "item_id": "17-008",
    "text": "得隆恃势故杀二命拟斩",
    "type": "判决",
    "reign": "本朝",
    "source": "17-008",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-005",
    "item_id": "17-019",
    "text": "立题授神机三营游击将军",
    "type": "题授",
    "reign": "万历",
    "source": "17-019",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-006",
    "item_id": "17-020",
    "text": "关白平秀吉者非人亦非妖盖蛟也",
    "type": "《斩蛟记》",
    "reign": "万历",
    "source": "17-020",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-007",
    "item_id": "17-021",
    "text": "钦州非用武之地君而亦非封拜之相",
    "type": "戏言",
    "reign": "嘉靖",
    "source": "17-021",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-008",
    "item_id": "17-025",
    "text": "猴见髡跣横行不类所习睹疑为异兽将噬之争燃火发炮",
    "type": "叙事",
    "reign": "嘉靖",
    "source": "17-025",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-009",
    "item_id": "17-031",
    "text": "大小松山尽入版图延袤千余里号为沃土",
    "type": "叙事",
    "reign": "万历",
    "source": "17-031",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-010",
    "item_id": "17-033",
    "text": "门垂夜月梨花冷帘卷东风燕子寒",
    "type": "诗句",
    "reign": "万历",
    "source": "17-033",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-011",
    "item_id": "17-009",
    "text": "俄上闻变，亟遣侍郎彭韶，领专敕巡视浙江",
    "type": "叙事",
    "reign": "弘治",
    "source": "17-009",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-012",
    "item_id": "17-012",
    "text": "历俸将满九年，会议开马市，忤高、张二相",
    "type": "叙事",
    "reign": "万历",
    "source": "17-012",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-013",
    "item_id": "17-016",
    "text": "石司马以集众思为名，多所采纳",
    "type": "叙事",
    "reign": "万历",
    "source": "17-016",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-014",
    "item_id": "17-016",
    "text": "张念华议集浙直福粤濒海四省之兵入海捣日本之巢为言路所驳罢不行",
    "type": "叙事",
    "reign": "万历",
    "source": "17-016",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-015",
    "item_id": "17-018",
    "text": "时蒋洲等，入海游说未归，当事俱忧之，募能再往者拜官",
    "type": "叙事",
    "reign": "嘉靖",
    "source": "17-018",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-016",
    "item_id": "17-022",
    "text": "本朝自宣德弃地后，尚修朝贡",
    "type": "叙事",
    "reign": "宣德",
    "source": "17-022",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-017",
    "item_id": "17-022",
    "text": "再请给印，时屡勘无他，乃又赐以新银印",
    "type": "特旨",
    "reign": "万历",
    "source": "17-022",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-018",
    "item_id": "17-026",
    "text": "李珍，寻以庚戌虏警，赦出复用，至大将",
    "type": "叙事",
    "reign": "嘉靖",
    "source": "17-026",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-019",
    "item_id": "17-028",
    "text": "自此边尘不惊，西陲寝烽者数岁",
    "type": "叙事",
    "reign": "隆庆",
    "source": "17-028",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-020",
    "item_id": "17-028",
    "text": "隆庆间，北虏效顺，各镇议马市讲款",
    "type": "叙事",
    "reign": "隆庆",
    "source": "17-028",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-021",
    "item_id": "17-035",
    "text": "时阁臣忧之，上疏直云：大江之中浩渺贼薮",
    "type": "叙事",
    "reign": "万历",
    "source": "17-035",
    "confidence": "high"
  },
  {
    "ming_id": "MING-17-022",
    "item_id": "17-035",
    "text": "则此万余金乃扬州监生代出，而林章主其议以上疏",
    "type": "叙事",
    "reign": "万历",
    "source": "17-035",
    "confidence": "high"
  }
