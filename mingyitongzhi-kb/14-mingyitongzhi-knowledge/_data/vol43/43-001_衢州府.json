      {"mtn_id": "MTN-001", "item_id": "43-001", "geo_id": "GEO-43001-c01", "name": "龟峰山", "type": "山", "location_text": "在府治后", "description": "其形如龟昂首垂足，与峥嵘山相连，唐罗隐有诗", "lore": ""},
      {"mtn_id": "MTN-002", "item_id": "43-001", "geo_id": "GEO-43001-c01", "name": "峥嵘山", "type": "山", "location_text": "在龟峰山西北", "description": "吴遣征虏将军郑平以千人守峥嵘镇即此；唐孟郊诗始见峥嵘状仰止逾可嘉", "lore": "三国吴峥嵘镇所在地"},
      {"mtn_id": "MTN-003", "item_id": "43-001", "geo_id": "GEO-43001-c01", "name": "烂柯山", "type": "山", "location_text": "在府城南二十里", "description": "一名石室，下有石桥，道书谓此山为青霞第八洞天烂柯福地；晋樵者王质入山伐木见二童子对弈，局终童子指示之曰汝斧柯烂矣，质归乡闾已及百岁", "lore": "王质烂柯传说，道教青霞第八洞天"},
      {"mtn_id": "MTN-004", "item_id": "43-001", "geo_id": "GEO-43001-c01", "name": "九龙山", "type": "山", "location_text": "在府城南二十里", "description": "相传邑人有客死括苍者其子以筏载棺归，抵山下为风波所覆；后求棺得诸石穴中，是夜雷雨有物飞出盖九龙，故名", "lore": ""},
      {"mtn_id": "MTN-005", "item_id": "43-001", "geo_id": "GEO-43001-c01", "name": "乌巨山", "type": "山", "location_text": "在府城东三十五里", "description": "两山连亘，其西山竹树荟蔚烟云出没一尘不到，尤为奇绝", "lore": ""},
      {"mtn_id": "MTN-006", "item_id": "43-001", "geo_id": "GEO-43001-c02", "name": "岑山", "type": "山", "location_text": "在龙游县南一十五里", "description": "其山自金华望之正当其面故号婺女照台山，邑中视之如笔架又呼为笔架山", "lore": ""},
      {"mtn_id": "MTN-007", "item_id": "43-001", "geo_id": "GEO-43001-c02", "name": "鸡鸣山", "type": "山", "location_text": "在龙游县南三里", "description": "宋嘉祐间邑人吕防讲学于此，时登山见鸡鸣丛棘中罗得白金数十镒输之官，后防三子皆高科人以为祥", "lore": "吕防讲学处"},
      {"mtn_id": "MTN-008", "item_id": "43-001", "geo_id": "GEO-43001-c02", "name": "灵山", "type": "山", "location_text": "在龙游县南四十里", "description": "旧名徐山，下有溪，溪外有徐偃王庙", "lore": ""},
      {"mtn_id": "MTN-009", "item_id": "43-001", "geo_id": "GEO-43001-c02", "name": "龙丘山", "type": "山", "location_text": "在龙游县东四十里", "description": "东阳记山有九石特秀色丹白远望状肖芙蓉，故一名九峰岩山；汉龙丘苌隐居于此与严子陵友善终年百岁，山际有三叠岩穴中有石床，唐徐安贞读书处", "lore": "龙丘苌隐居处"},
      {"mtn_id": "MTN-010", "item_id": "43-001", "geo_id": "GEO-43001-c02", "name": "白石山", "type": "山", "location_text": "在龙游县南四十五里", "description": "山有圆石耸二十余丈其色纯白故名，唐尝以此山名县", "lore": ""},
      {"mtn_id": "MTN-011", "item_id": "43-001", "geo_id": "GEO-43001-c03", "name": "三衢山", "type": "山", "location_text": "在常山县北二十五里", "description": "昔有洪水暴出派兹山为三道故名；峭峰奇石玲珑绀碧夭矫，上有岩洞名曰碧玉，中有石室旁通二门榜曰玉龙", "lore": "衢州得名由来"},
      {"mtn_id": "MTN-012", "item_id": "43-001", "geo_id": "GEO-43001-c03", "name": "石门山", "type": "山", "location_text": "在常山县北二十五里", "description": "山巅有窍每旦出云，过东则雨验之多应", "lore": ""},
      {"mtn_id": "MTN-013", "item_id": "43-001", "geo_id": "GEO-43001-c04", "name": "江郎山", "type": "山", "location_text": "在江山县南五十里", "description": "俗传尝有江氏兄弟三人登山巅化为石故名；山顶有池产碧莲金鲫；宋王禹偁诗三茅遗躅在金陵又见江家有弟兄", "lore": "江氏兄弟化石传说"},
      {"mtn_id": "MTN-014", "item_id": "43-001", "geo_id": "GEO-43001-c04", "name": "浮盖仙山", "type": "山", "location_text": "在江山县南一百里", "description": "中有仙洞石坛石屏奇怪百出，又多红桃花而不实；宋汪藻诗浮空高展神仙盖列障长开水墨屏", "lore": ""},
      {"mtn_id": "MTN-015", "item_id": "43-001", "geo_id": "GEO-43001-c04", "name": "泉山", "type": "山", "location_text": "在江山县南一百三十里", "description": "山周围数百里皆高崖深谷，汉书朱买臣言闽越王所保是也", "lore": ""},
      {"mtn_id": "MTN-016", "item_id": "43-001", "geo_id": "GEO-43001-c05", "name": "石耳山", "type": "山", "location_text": "在开化县西八十里", "description": "周围三百里连亘婺源德兴二县界，中有三仙祠", "lore": ""},
      {"mtn_id": "MTN-017", "item_id": "43-001", "geo_id": "GEO-43001-c05", "name": "古田山", "type": "山", "location_text": "在开化县西八十里", "description": "山中虎不啮蛇不螫，中有灵湫每旦有云一缕浮空而出，所向之方辄雨", "lore": ""},
      {"mtn_id": "MTN-018", "item_id": "43-001", "geo_id": "GEO-43001-c04", "name": "仙霞岭", "type": "岭", "location_text": "在江山县南一百里", "description": "宋史浩帅闽过此募人以石甃路三百六十级；为入闽咽喉之地", "lore": "入闽要道，仙霞关所在"},
      {"mtn_id": "MTN-019", "item_id": "43-001", "geo_id": "GEO-43001-c01", "name": "信安溪", "type": "溪", "location_text": "在府城西二里", "description": "一名西溪，环城西北东流入龙游县界号盈川溪，至县北五里又名縠溪，东流与东阳江合历严达杭入于海", "lore": ""},
      {"mtn_id": "MTN-020", "item_id": "43-001", "geo_id": "GEO-43001-c01", "name": "定阳溪", "type": "溪", "location_text": "在府城东九里", "description": "一名东溪，源出处州遂昌县之周公源东北流入本县界，至鸡鸣山下与信安溪合，其分派筑堰导流迤北溉田五万六千余亩", "lore": ""},
      {"mtn_id": "MTN-021", "item_id": "43-001", "geo_id": "GEO-43001-c02", "name": "縠溪", "type": "溪", "location_text": "在龙游县北五里", "description": "汉志太末县有縠水，唐置縠州以此", "lore": ""},
      {"mtn_id": "MTN-022", "item_id": "43-001", "geo_id": "GEO-43001-c04", "name": "文溪", "type": "溪", "location_text": "在江山县南三十五里", "description": "其源有四：一自石鼓山一自广源一自永丰之后源一自括苍之半桃山，合为是溪", "lore": ""},
      {"mtn_id": "MTN-023", "item_id": "43-001", "geo_id": "GEO-43001-c05", "name": "金溪", "type": "溪", "location_text": "在开化县北四十里", "description": "源出马金岭下西北流绕县治名金溪，又转而东南流经常山县郭名金川，下流与文溪合为信安溪", "lore": ""},
