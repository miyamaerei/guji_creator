      },
      {
        "geo_id": "GEO-37007-w05",
        "item_id": "37-007",
        "name": "甘州后卫",
        "type": "weisuo",
        "region": "陕西行都司",
        "parent": "GEO-37007",
        "children": [],
        "volume_range": "卷37",
        "attributes": {
