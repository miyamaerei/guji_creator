      {
        "geo_id": "GEO-37007-w01",
        "item_id": "37-007",
        "name": "甘州左卫",
        "type": "weisuo",
        "region": "陕西行都司",
        "parent": "GEO-37007",
        "children": [],
        "volume_range": "卷37",
        "attributes": {
          "location_text": "附郭；本匈奴昆邪王地，汉置张掖郡，取张国臂掖之义；后又置属国都尉以主蛮夷降者；魏晋并因之；后魏改张掖军寻改军为郡又置西凉州；西魏更名甘州，取州东甘浚山泉味甘冽为名；后周复为张掖郡；唐初为甘州，天宝初复为郡，乾元初复为甘州；宋初为西夏所据，改镇夷郡又改宣德府；元改甘肃路寻改甘州路；本朝为甘肃卫寻分置甘州左卫",
          "garrison_type": "卫"
        }
      },
      {
        "geo_id": "GEO-37007-w02",
