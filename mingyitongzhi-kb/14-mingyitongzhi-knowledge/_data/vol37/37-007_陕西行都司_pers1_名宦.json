  "pers": [
   {
    "pers_id": "PER-001",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "辛武贤",
    "dynasty": "汉",
    "source_section": "名宦",
    "note": "酒泉太守，时赵充国欲俟虏疲弊乃击之，武贤上言以秋分兵击罕开夺其人畜，冬复击之，帝嘉纳其言，赐玺书拜为破羌将军"
   },
   {
    "pers_id": "PER-002",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "辛庆忌",
    "dynasty": "汉",
    "source_section": "名宦",
    "note": "张掖太守徙酒泉，所在著名"
   },
   {
    "pers_id": "PER-003",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "窦融",
    "dynasty": "汉",
    "source_section": "名宦",
    "note": "更始初为张掖属国都尉，政尚宽和，后为吏民所推，行河西五郡大将军事；光武即位遣使入贡，因赐玺书拜凉州牧"
   },
   {
    "pers_id": "PER-004",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "任延",
    "dynasty": "汉",
    "source_section": "名宦",
    "note": "武威太守，光武戒之曰善事上官无失名誉，延对曰履正奉公臣子之节，善事上官臣不敢奉诏；在郡威行境内，修理沟渠，人蒙其利"
   },
   {
    "pers_id": "PER-005",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "梁统",
    "dynasty": "汉",
    "source_section": "名宦",
    "note": "酒泉太守，从政尚严猛，威行邻郡"
   },
   {
    "pers_id": "PER-006",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "第五访",
    "dynasty": "汉",
    "source_section": "名宦",
    "note": "张掖太守，岁饥开廪赈给，吏惧谴争欲上言，访曰若上须报是弃民也，太守乐以一身救百姓，遂出谷赋人，玺书嘉之"
   },
   {
    "pers_id": "PER-007",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "种暠",
    "dynasty": "汉",
    "source_section": "名宦",
    "note": "凉州刺史，甚得百姓欢心，被征当迁，吏民诣阙请留，乃许复留一年"
   },
   {
    "pers_id": "PER-008",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "邓训",
    "dynasty": "汉",
    "source_section": "名宦",
    "note": "护羌校尉，湟中诸胡感其恩信相率归附，训遂罢屯兵惟分理屯田，修坞壁，边境以宁"
   },
   {
    "pers_id": "PER-009",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "孔奋",
    "dynasty": "汉",
    "source_section": "名宦",
    "note": "守姑臧，常力行清洁，后被征单车就路，姑臧吏民敛送牛马诸物一无所受"
   },
   {
    "pers_id": "PER-010",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "翟酺",
    "dynasty": "汉",
    "source_section": "名宦",
    "note": "安帝时酒泉太守，时叛羌掠郡境，酺击之诛灭殆尽，威名大震"
   },
   {
    "pers_id": "PER-011",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "皇甫规",
    "dynasty": "汉",
    "source_section": "名宦",
    "note": "中郎将，讨先零诸羌破之，羌遂遣使乞降，凉州复通"
   },
   {
    "pers_id": "PER-012",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "徐邈",
    "dynasty": "三国",
    "source_section": "名宦",
    "note": "魏明帝时凉州刺史，立学明训，禁厚葬，断淫祠，进善黜恶，风化大行，西域流通"
   },
   {
    "pers_id": "PER-013",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "仓慈",
    "dynasty": "三国",
    "source_section": "名宦",
    "note": "魏炖煌太守，抑挫权右，抚恤贫羸，民夷翕然称其德惠；数年卒，吏民悲感图画其形"
   },
   {
    "pers_id": "PER-014",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "马隆",
    "dynasty": "晋",
    "source_section": "名宦",
    "note": "武帝时树机能陷凉州，隆将兵讨破之，凉州遂平"
   },
   {
    "pers_id": "PER-015",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "张轨",
    "dynasty": "晋",
    "source_section": "名宦",
    "note": "凉州牧，时鲜卑犯掠，轨讨破之，威著西土，遂据凉州号前凉"
   },
   {
    "pers_id": "PER-016",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "司马望",
    "dynasty": "晋",
    "source_section": "名宦",
    "note": "持节都督雍凉二州军事，在任八年威化明肃"
   },
   {
    "pers_id": "PER-017",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "李暠",
    "dynasty": "晋",
    "source_section": "名宦",
    "note": "肃州西曹掾从事，补司马别驾，转炖煌太守领护西夷校尉，后为凉州牧称西凉王"
   },
   {
    "pers_id": "PER-018",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "杨恭仁",
    "dynasty": "隋",
    "source_section": "名宦",
    "note": "仁寿中甘州刺史，临事不苛细，徼人安之；文帝谓其父雄曰匪特朕得人乃卿善教子矣"
   },
   {
    "pers_id": "PER-019",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "李大亮",
    "dynasty": "唐",
    "source_section": "名宦",
    "note": "西北道安抚大使，诏欲贮粮碛口以赈西突厥，大亮言劳费无益不如罢之，其或自立君长求内属者羁縻受之使居塞外为中国藩蔽，帝从之"
   },
   {
    "pers_id": "PER-020",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "唐璿",
    "dynasty": "唐",
    "source_section": "名宦",
    "note": "凉州都督，时吐蕃犯凉州，璿率众击之六战皆克"
   },
   {
    "pers_id": "PER-021",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "郭震",
    "dynasty": "唐",
    "source_section": "名宦",
    "note": "凉州都督，先是突厥吐蕃常逼城下，震始控其冲要，虏不复至；又令凉州刺史李汉通垦置屯田积粟数千斛，军用以足，夷夏畏慕"
   },
   {
    "pers_id": "PER-022",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "王方翼",
    "dynasty": "唐",
    "source_section": "名宦",
    "note": "高宗时肃州刺史，烽逻精明，河西蝗独不至方翼境，而他郡民或馁死，方翼治下全活甚众，芝产其地"
   },
   {
    "pers_id": "PER-023",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "杜希望",
    "dynasty": "唐",
    "source_section": "名宦",
    "note": "玄宗时鄯州都督，时军屡兴府库虚寡，希望居数岁刍粟金帛丰余"
   },
   {
    "pers_id": "PER-024",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "张守珪",
    "dynasty": "唐",
    "source_section": "名宦",
    "note": "开元中为瓜州刺史，虏奄至众失色，守珪置酒城上会诸将作乐，虏疑有备不敢攻引去，守珪纵兵击败之，迁瓜州都督"
   },
   {
    "pers_id": "PER-025",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "高永年",
    "dynasty": "宋",
    "source_section": "名宦",
    "note": "知西宁州，时夏人犯泾原，賊罗撒合兵逼城，永年出御之被执，不屈而死"
   },
   {
    "pers_id": "PER-026",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "巴图",
    "dynasty": "元",
    "source_section": "名宦",
    "note": "延祐初甘肃行省平章政事，时米价腾涌，陆挽一石费二百缗，乃为经画计所省至四百余万缗，自是诸仓充溢，岁饥则发粟赈之，春缺种则贷之，兵饷既足民食亦给"
   },
   {
    "pers_id": "PER-027",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "濮瑛",
    "dynasty": "明",
    "source_section": "名宦",
    "note": "凉州卫指挥使，洪武中修葺城楼仓库，措置有方，士卒不劳而事集，郡称智能；寻以擒叛贼功升右军都督佥事，掌陕西行都司事"
   },
   {
    "pers_id": "PER-028",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "刘林",
    "dynasty": "明",
    "source_section": "名宦",
    "note": "凉州卫百户，洪武中土官额森特穆尔等逃叛攻掠凉州，林击贼至城西土台力战而殁；事闻上嘉其忠勇，遣祭于台下"
   },
   {
    "pers_id": "PER-029",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "宋晟",
    "dynasty": "明",
    "source_section": "名宦",
    "note": "洪武中讨哈密有功，永乐初又遣都指挥史昭出兵擒火者厮通，西域贡道加封，晟至西宁侯镇守甘肃；子琥袭父爵亦在甘肃镇守"
   },
   {
    "pers_id": "PER-030",
    "item_id": "37-007",
    "geo_id": "GEO-37007",
    "name": "蒋贵",
    "dynasty": "明",
    "source_section": "名宦",
    "note": "正统初敌人犯边，贵充总兵至甘肃击败敌众，以功升定西伯，镇守甘肃，边境宁谧"
   }
