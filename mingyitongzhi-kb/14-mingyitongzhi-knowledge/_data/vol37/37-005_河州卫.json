   {"pers_id": "PER-001", "item_id": "37-005", "geo_id": "GEO-37005", "name": "李浩", "dynasty": "宋", "source_section": "名宦", "note": "熙河路副总管知河州，安抚洮西五路大举，浩将前军复兰州，遂知兰州事"},
   {"pers_id": "PER-002", "item_id": "37-005", "geo_id": "GEO-37005", "name": "刘仲武", "dynasty": "宋", "source_section": "名宦", "note": "知河州，吐蕃赵怀德等众数万叛，仲武相持数日潜遣二将还羌，遇伏大败，斩首二千级，复西宁州"},
   {"pers_id": "PER-003", "item_id": "37-005", "geo_id": "GEO-37005", "name": "种朴", "dynasty": "宋", "source_section": "名宦", "note": "知河州安抚洮西沿边公事，河南蕃部叛，属羌阿章率他族拒官军，朴出战遇伏力战而死"},
   {"pers_id": "PER-004", "item_id": "37-005", "geo_id": "GEO-37005", "name": "姚雄", "dynasty": "宋", "source_section": "名宦", "note": "知河州，时种朴战没王赡军陷敌中，雄自鄯至湟四战皆胜拔出之；遂筑安乡关夹河立堡以护浮梁"},
   {"pers_id": "PER-005", "item_id": "37-005", "geo_id": "GEO-37005", "name": "苗授", "dynasty": "宋", "source_section": "名宦", "note": "时鬼章寇河州，诏授往一战克撒宗论功第一，遂知州事；后又讨生羌获其大酋，威震洮西"},
   {"pers_id": "PER-006", "item_id": "37-005", "geo_id": "GEO-37005", "name": "韦正", "dynasty": "明", "source_section": "名宦", "note": "洪武三年为河州卫指挥使，以茶布给军士令自相贸易省西民转输之劳；初至卫城邑空虚，日夜抚循其民，河州遂为乐土"},
   {"pers_id": "PER-007", "item_id": "37-005", "geo_id": "GEO-37005", "name": "刘昭", "dynasty": "明", "source_section": "名宦", "note": "洪武末以陕西都指挥同知镇河州；永乐中领兵往乌思藏赏诸国还，遇番贼劫掠，率众败之"},
