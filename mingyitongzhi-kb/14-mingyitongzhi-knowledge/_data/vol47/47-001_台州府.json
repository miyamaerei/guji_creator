      {"mtn_id": "MTN-008", "item_id": "47-001", "geo_id": "GEO-47001-c02", "name": "永宁山", "type": "山", "location_text": "在黄岩县东五里", "description": "因古县而名，一名方山", "lore": ""},
      {"mtn_id": "MTN-009", "item_id": "47-001", "geo_id": "GEO-47001-c02", "name": "丹崖山", "type": "山", "location_text": "在黄岩县西四十五里", "description": "崖石俱赤有金银星，世传仙人炼丹于此，有池深可尺余名炼丹井", "lore": ""},
      {"mtn_id": "MTN-010", "item_id": "47-001", "geo_id": "GEO-47001-c03", "name": "赤城山", "type": "山", "location_text": "在天台县北六里", "description": "土皆赤色状似云霞望之如雉堞然故名", "lore": "晋孙绰赋赤城霞起以建标即此；玉京洞为道书第六洞天"},
