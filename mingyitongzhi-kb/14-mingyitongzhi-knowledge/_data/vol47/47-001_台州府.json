      {"mtn_id": "MTN-013", "item_id": "47-001", "geo_id": "GEO-47001-c03", "name": "华顶峰", "type": "峰", "location_text": "在天台县东北六十里", "description": "周回百余里高万丈，绝顶东望沧海俗称望海尖，草木薰郁殆非人世夏有积雪", "lore": "唐李白诗天台邻四明华顶高百越即此"},
      {"mtn_id": "MTN-014", "item_id": "47-001", "geo_id": "GEO-47001-c03", "name": "寒石山", "type": "山", "location_text": "在天台县西北七十里", "description": "一名寒岩，上有仙人石，唐寒山子居之", "lore": "寒山子隐居处"},
      {"mtn_id": "MTN-015", "item_id": "47-001", "geo_id": "GEO-47001-c04", "name": "福应山", "type": "山", "location_text": "在仙居县东二里", "description": "宋皇祐间县令陈襄名之，阴阳家谓其邑治得龙首之胜，居人建浮图于上", "lore": "陈襄命名"},
