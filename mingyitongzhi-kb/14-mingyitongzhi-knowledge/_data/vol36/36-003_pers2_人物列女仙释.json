    "dynasty": "唐",
    "native_place": "襄阳",
    "office": "右拾遗",
    "summary": "禄山之乱甫避兵三川，肃宗立复自鄜奔行在拜右拾遗；时所在寇夺，甫家寓鄜弥年艰窭，孺弱至饿死"
   },
   {
    "per_id": "PER-002",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "秦族",
    "type": "人物",
    "dynasty": "南北朝",
    "native_place": "洛川",
    "office": "",
    "summary": "后周洛川人，性至孝，父丧哀毁过礼；以母在抑割哀情以慰母心，与弟荣先笃友爱；母没终丧之后不入房室者二十年，乡里感叹，诏旌表之"
   },
   {
    "per_id": "PER-003",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "张平高",
    "type": "人物",
    "dynasty": "唐",
    "native_place": "绥州",
    "office": "丹州刺史",
    "summary": "隋末为鹰扬府校尉戍太原，从唐高祖平京城，累授左领军将军封萧国公；贞观初为丹州刺史，卒追封罗国公赠潭州都督"
   },
   {
    "per_id": "PER-004",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "李继周",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "延州金明",
    "office": "成州刺史",
    "summary": "祖计都父孝俱为金明镇使，太宗时继周率众败番落，累迁殿直，后以讨西夏功累迁成州刺史"
   },
   {
    "per_id": "PER-005",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "王文郁",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "新秦",
    "office": "冀州观察使",
    "summary": "为府州巡检，韩琦荐其材加阁门祗候麟府都监，尝破夏人，累迁知麟州，后为冀州观察使"
   },
   {
    "per_id": "PER-006",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "杨畋",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "新秦",
    "office": "龙图阁直学士知谏院",
    "summary": "举进士累官殿中丞，讨平湖南徭贼，后累迁龙图阁直学士知谏院；性清介家无余赀，卒赠右谏议大夫"
   },
   {
    "per_id": "PER-007",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "张岊",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "府谷",
    "office": "麟府路巡检使",
    "summary": "庆历初为麟府路巡检使，有胆略善骑射；时西夏阿遇背约，岊径造帐中谕以逆顺，阿遇语屈，因抚其背曰真男子也，归所掠如故约"
   },
   {
    "per_id": "PER-008",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "杨偕",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "中部",
    "office": "工部侍郎",
    "summary": "少从种放学，举进士，性刚而忠朴，在官数上书论时政；郭皇后废，偕与孔道辅等力争；元昊入寇，诏偕选强壮策应麟府，偕奏请以军法从事，于是军政肃然；累迁翰林侍读学士以工部侍郎致仕，有兵书十五卷文集十卷"
   },
   {
    "per_id": "PER-009",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "李浩",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "绥州",
    "office": "鄜延太原永兴环庆路副都总管",
    "summary": "务学通兵法，以破侬智高功为广西都监，尝着安边策；神宗时又以讨黔江蛮累官知河州，后历鄜延太原永兴环庆路副都总管"
   },
   {
    "per_id": "PER-010",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "刘绍能",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "保安军",
    "office": "简州团练使",
    "summary": "以父怀忠与夏寇战死，录为右班殿直，累迁鄜延路兵马都监；后统军进讨夏人，设疑以间之，神宗手诏曰绍能忠勇第一此必夏人畏忌间之耳；守边四十七年大小五十战，终简州团练使"
   },
   {
    "per_id": "PER-011",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "高永能",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "青涧",
    "office": "荣州团练使",
    "summary": "勇力善射，种谔取绥州，永能先驱入啰兀五战皆捷，后累进荣州团练使；永乐之役献谋不用，城陷战而死；永能抚部曲有恩，遇敌则身先之，下有伤者载以己副马，故能得士死力"
   },
   {
    "per_id": "PER-012",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "刘延庆",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "保安军",
    "office": "保信军节度使",
    "summary": "雄豪有勇，尝从西伐屡立战功，累迁泰宁军留后；徽宗时破夏人有功，拜保信军节度使"
   },
   {
    "per_id": "PER-013",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "李翼",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "麟州新秦",
    "office": "代州西路都巡检使",
    "summary": "宣和末为代州西路都巡检使屯崞县，金人取代，翼坚守，统领崔忠夜引金兵入城，翼搏战不敌被执，尼玛哈欲臣之，怒骂不屈而死"
   },
   {
    "per_id": "PER-014",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "刘光世",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "保安军",
    "office": "镇海军节度使",
    "summary": "延庆子，以讨河北贼有功拜镇海军节度使，后从高宗南渡累立战功，封杨国公，卒谥武僖，后追封鄜王"
   },
   {
    "per_id": "PER-015",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "韩世忠",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "延安",
    "office": "横海武宁安化三镇节度使",
    "summary": "目瞬如电鸷勇绝伦，以应募立功，擒方腊讨河北盗贼，从高宗南渡平苗刘之乱，大破金乌珠于江中，累迁横海武宁安化三镇节度使；以不主和议忤秦桧，解枢柄奉朝请，后封咸安郡王，卒谥忠武，为中兴名将"
   },
   {
    "per_id": "PER-016",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "张宗颜",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "延安",
    "office": "崇信军承宣使",
    "summary": "父吉为泾原将解宣威城围死之，宗颜补官累迁崇信军承宣使；刘豫入寇，宗颜自泗州为张俊继，遇刘猊大破之，卒赠节度谥壮敏"
   },
   {
    "per_id": "PER-017",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "韩彦直",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "延安",
    "office": "工部尚书兼知临安府",
    "summary": "世忠子，登进士第调太社令，累官工部尚书兼知临安府，屡进谠言，后以龙图阁学士提举万寿观，卒封蕲春郡公；尝摭宋朝事分为类目名水心镜凡百六十七卷"
   },
   {
    "per_id": "PER-018",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "解元",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "保安军德靖寨",
    "office": "保信军节度使",
    "summary": "猿臂善骑射，从韩世忠平苗刘之乱，后以战功累官保信军节度使，卒赠检校少保"
   },
   {
    "per_id": "PER-019",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "李永奇",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "青涧",
    "office": "苏尾九族巡检",
    "summary": "世袭苏尾九族巡检，金人陷延安授永奇及其子显忠官，永奇泣曰我宋臣也乃为彼用耶；会刘豫令显忠率兵赴汴，永奇密戒曰汝得乘机即归本朝；及显忠以计执金帅，永奇挈家出城为金人所及，家属二百口皆遇害"
   },
   {
    "per_id": "PER-020",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "李显忠",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "青涧",
    "office": "威武军节度使",
    "summary": "永奇子，年十七即随父出入行阵，及归朝屡败金兵，授殿前都指挥使；显忠生长边陲熟悉敌情，每用兵必先计而后战，时称为真关西将军；孝宗召除威武军节度，奇其状貌魁杰命绘像阁下，卒谥忠襄"
   },
   {
    "per_id": "PER-021",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "朱昭",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "府谷",
    "office": "震威城兵马监押",
    "summary": "金人入寇，昭以死守城，将陷召诸校谓曰大丈夫暴骨境内一生之事毕矣，第妻子不可为敌所污，因令尽杀之，乃与敌战杀获甚众，马蹶坠堑仗剑骂敌而死"
   },
   {
    "per_id": "PER-022",
    "item_id": "36-003",
    "geo_id": "GEO-36003",
    "name": "折可适",
    "type": "人物",
    "dynasty": "宋",
    "native_place": "府州",
    "office": "淮康军节度使",
    "summary": "其先世为府州刺史因家焉，可适未冠有勇驰射不习而能，郭逵荐为鄜延路经略司属官，有战功累迁淮康军节度使；子彦质绍兴中佥书枢密院事"
   },
