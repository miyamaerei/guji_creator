  "opns": [
    {"key":"opn:xupu-chucai","vol":46,"item_id":"46-006","slot":3,"type":"奏议","stance":"建言","speaker":{"text":"大学士徐溥","person_keys":["ent:xupu"]},"target":{"text":"庶吉士考选定制"},"quote":"自古帝王储才馆阁以教养之。本朝所以储养之者，自及第进士之外，止有庶吉士一途，而或选或否。且有才者未必皆选，所选者未必皆才，若更拘地方、年岁，则是已成之才又多弃而不用也。请自今以后，立为定制，一次开科，一次选用。","markers":["请","不可"],"era":{"reign":"弘治","year":4},"reg_keys":["reg:shujishi"],"ent_keys":["ent:xupu"],"src_loc":"卷46-L33","confidence":0.95},
    {"key":"opn:xieduo-kaoguan","vol":46,"item_id":"46-006","slot":4,"type":"疏","stance":"批评","speaker":{"text":"掌国子监谢铎","person_keys":["ent:xieduo"]},"target":{"text":"考官之弊"},"quote":"考官皆御史方面所辟召，职分即卑，听其指使，以外帘官预定去取，名为防闲，实则关节，而科举之法坏矣。乞敕两京大臣，各举部属等官素有文望者，每省差二员主考，庶几前弊可革。","markers":["弊","坏","乞"],"era":{"reign":"弘治","year":14},"reg_keys":["reg:kaoguan"],"ent_keys":["ent:xieduo"],"src_loc":"卷46-L30","confidence":0.94},
    {"key":"opn:zhangcong-jingguan","vol":46,"item_id":"46-013","slot":3,"type":"建言","stance":"建言","speaker":{"text":"兵部侍郎张璁","person_keys":["ent:zhangcong"]},"target":{"text":"各省主试遣京官"},"quote":"彼时因主考与监临官礼节小嫌，故行止二科而罢，今宜仍遣廷臣。由是浙江、江西、福建、湖广皆用编修、检讨，他省用科部官。","markers":["宜","议"],"era":{"reign":"万历","year":11},"reg_keys":["reg:kaoguan"],"ent_keys":["ent:zhangcong"],"src_loc":"卷46-L30","confidence":0.93},
    {"key":"opn:weiyunzhen-fuchen","vol":46,"item_id":"46-022","slot":1,"type":"疏","stance":"批评","speaker":{"text":"御史魏允贞","person_keys":[]},"target":{"text":"辅臣子不宜中式"},"quote":"御史魏允贞疏陈时弊，言辅臣子不宜中式。","markers":["言","弊"],"era":{"reign":"万历","year":0},"reg_keys":["reg:keju-sanji"],"evt_keys":["evt:fuchen-zidi"],"src_loc":"卷46-L35","confidence":0.9},
    {"key":"opn:gaogong-santu","vol":47,"item_id":"47-004","slot":3,"type":"论","stance":"批评","speaker":{"text":"大学士高拱","person_keys":["ent:gaogong"]},"target":{"text":"三途并用资格"},"quote":"国初，举人跻八座为名臣者甚众。后乃进士偏重，而举人甚轻，至于今极矣。请自授官以后，惟考政绩，不问其出身。","markers":["请","不可"],"era":{"reign":"隆庆","year":0},"reg_keys":["reg:santu"],"ent_keys":["ent:gaogong"],"src_loc":"卷47-L46","confidence":0.93},
    {"key":"opn:xiayan-baoju","vol":47,"item_id":"47-012","slot":4,"type":"疏","stance":"建言","speaker":{"text":"给事中夏言","person_keys":[]},"target":{"text":"保举方面郡守"},"quote":"嘉靖八年，给事中夏言复请循弘治故事，且及举劾贤否略节，每季孟月，部臣送科以达御前，命著为令。","markers":["请","议"],"era":{"reign":"嘉靖","year":8},"reg_keys":["reg:baoju"],"src_loc":"卷47-L48","confidence":0.92},
    {"key":"opn:huotao-junzhi","vol":47,"item_id":"47-005","slot":3,"type":"论","stance":"批评","speaker":{"text":"詹事霍韬","person_keys":["ent:huotao"]},"target":{"text":"军职冗滥"},"quote":"成化中，增太祖时军职四倍，今又增几倍矣。锦衣初额官二百五员，今至千七百员，殆增八倍……宜命大臣循清黄例，内外武职一切差次功劳，考其祖宗相承，默寓汰省之法。","markers":["弊","宜"],"era":{"reign":"嘉靖","year":0},"reg_keys":["reg:wuxuan"],"ent_keys":["ent:huotao"],"src_loc":"卷47-L55","confidence":0.92},
    {"key":"opn:zhangmao-xuangong","vol":45,"item_id":"45-011","slot":6,"type":"疏","stance":"建言","speaker":{"text":"南京祭酒章懋","person_keys":[]},"target":{"text":"选贡之法"},"quote":"乞于常贡外令提学行选贡之法，不分廪膳、增广生员，通行考选，务求学行兼优、年富力强、累试优等者，乃以充贡。通计天下之广，约取五六百人。","markers":["乞","请"],"era":{"reign":"弘治","year":0},"reg_keys":["reg:gongju"],"src_loc":"卷45-L12","confidence":0.92},
    {"key":"opn:guorusin-tingxuan","vol":45,"item_id":"45-011","slot":7,"type":"论","stance":"批评","speaker":{"text":"工科郭如心","person_keys":[]},"target":{"text":"停选贡"},"quote":"选贡非祖制，其始欲补岁贡之乏，其后遂妨岁贡之途，请停其选。","markers":["请","非"],"era":{"reign":"万历","year":0},"reg_keys":["reg:gongju"],"src_loc":"卷45-L12","confidence":0.91},
    {"key":"opn:wanli-libu-wen","vol":45,"item_id":"45-016","slot":2,"type":"论","stance":"批评","speaker":{"text":"礼部","person_keys":["ent:libu"]},"target":{"text":"举业文体流弊"},"quote":"国初举业有用六经语者，其后引《左传》、《国语》矣，又引《史记》、《汉书》矣……弘治、正德、嘉靖初年，中式文字纯正典雅。宜选其尤者，刊布学宫，俾知趋向。","markers":["弊","宜"],"era":{"reign":"万历","year":15},"obj_keys":["obj:bagu"],"src_loc":"卷45-L16","confidence":0.91},
    {"key":"opn:wangdaochun-zige","vol":47,"item_id":"47-004","slot":4,"type":"论","stance":"批评","speaker":{"text":"御史王道纯","person_keys":[]},"target":{"text":"用人资格"},"quote":"帝谓用人当论才，本不合拘资格，下所司酌行之。","markers":["当"],"era":{"reign":"崇祯","year":0},"reg_keys":["reg:santu"],"src_loc":"卷47-L47","confidence":0.9},
    {"key":"opn:gaogui-wangheng","vol":46,"item_id":"46-022","slot":2,"type":"疏","stance":"批评","speaker":{"text":"礼部郎中高桂","person_keys":[]},"target":{"text":"王衡覆试"},"quote":"自故相子一时并进，而大臣之子遂无见信于天下者。今辅臣锡爵子衡，素号多才，青云不难自致，而人犹疑信相半，宜一体覆试，以明大臣之心迹。","markers":["疑","宜"],"era":{"reign":"万历","year":16},"evt_keys":["evt:fuchen-zidi"],"src_loc":"卷46-L35","confidence":0.9}
