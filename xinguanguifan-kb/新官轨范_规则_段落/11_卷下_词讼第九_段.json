{
 "schema_version": "kg-seg-json-v1",
 "volume": "11",
 "chapter": "卷下_词讼第九",
 "source_file": "11_卷下_词讼第九.xhtml",
 "item_count": 15,
 "segment_count": 30,
 "segments": [
  {
   "seg_id": "11-001-01",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 1,
   "seg_no": 1,
   "source": "11_卷下_词讼第九.xhtml#条1#段1",
   "text": "凡斗殴者，俱要当日陈告拘拿到官。",
   "offset": {
    "start": 0,
    "end": 16
   }
  },
  {
   "seg_id": "11-001-02",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 1,
   "seg_no": 2,
   "source": "11_卷下_词讼第九.xhtml#条1#段2",
   "text": "验实有伤，责令直日医生带同原、被害告人于廨处眼同医治，供给汤药，平复回报。",
   "offset": {
    "start": 16,
    "end": 53
   }
  },
  {
   "seg_id": "11-001-03",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 1,
   "seg_no": 3,
   "source": "11_卷下_词讼第九.xhtml#条1#段3",
   "text": "如伤重不堪调理，须呈白究治，将原犯入监。",
   "offset": {
    "start": 53,
    "end": 73
   }
  },
  {
   "seg_id": "11-002-01",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 2,
   "seg_no": 1,
   "source": "11_卷下_词讼第九.xhtml#条2#段1",
   "text": "凡兄弟叔侄及亲戚争论，不能决者，每日监内并锁连杻带出申明亭示众，以候各犯自悔如息。",
   "offset": {
    "start": 0,
    "end": 41
   }
  },
  {
   "seg_id": "11-003-01",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 3,
   "seg_no": 1,
   "source": "11_卷下_词讼第九.xhtml#条3#段1",
   "text": "凡家主告奴仆盗财物，奴仆告家主奸妻女，多系诬捏，不要轻准。",
   "offset": {
    "start": 0,
    "end": 29
   }
  },
  {
   "seg_id": "11-004-01",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 4,
   "seg_no": 1,
   "source": "11_卷下_词讼第九.xhtml#条4#段1",
   "text": "凡妇人告夫，或夫告妇，须仔细观律处理，不可轻易发落。",
   "offset": {
    "start": 0,
    "end": 26
   }
  },
  {
   "seg_id": "11-005-01",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 5,
   "seg_no": 1,
   "source": "11_卷下_词讼第九.xhtml#条5#段1",
   "text": "凡告子不孝，虽有可怜之情，亦须痛责，不可姑息，以伤伦理。",
   "offset": {
    "start": 0,
    "end": 28
   }
  },
  {
   "seg_id": "11-005-02",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 5,
   "seg_no": 2,
   "source": "11_卷下_词讼第九.xhtml#条5#段2",
   "text": "父纵不慈，不可加罪。",
   "offset": {
    "start": 28,
    "end": 38
   }
  },
  {
   "seg_id": "11-006-01",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 6,
   "seg_no": 1,
   "source": "11_卷下_词讼第九.xhtml#条6#段1",
   "text": "凡告人命，远不三日，过期告理不准。",
   "offset": {
    "start": 0,
    "end": 17
   }
  },
  {
   "seg_id": "11-006-02",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 6,
   "seg_no": 2,
   "source": "11_卷下_词讼第九.xhtml#条6#段2",
   "text": "若谋杀、故杀，检验亦不过三日，若过期杀及斗殴致死者，须要勘提，不可巡抚，以误两家。",
   "offset": {
    "start": 17,
    "end": 58
   }
  },
  {
   "seg_id": "11-007-01",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 7,
   "seg_no": 1,
   "source": "11_卷下_词讼第九.xhtml#条7#段1",
   "text": "告些小钱债，及无力家贫被骗，即与管理拘追。",
   "offset": {
    "start": 0,
    "end": 21
   }
  },
  {
   "seg_id": "11-007-02",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 7,
   "seg_no": 2,
   "source": "11_卷下_词讼第九.xhtml#条7#段2",
   "text": "若富豪之家，并所告人多及钱米数多者，不与追理。",
   "offset": {
    "start": 21,
    "end": 44
   }
  },
  {
   "seg_id": "11-008-01",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 8,
   "seg_no": 1,
   "source": "11_卷下_词讼第九.xhtml#条8#段1",
   "text": "告田土，须着实踏看。",
   "offset": {
    "start": 0,
    "end": 10
   }
  },
  {
   "seg_id": "11-008-02",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 8,
   "seg_no": 2,
   "source": "11_卷下_词讼第九.xhtml#条8#段2",
   "text": "若得公事，须便自行到彼一问，胜如委人。",
   "offset": {
    "start": 10,
    "end": 29
   }
  },
  {
   "seg_id": "11-008-03",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 8,
   "seg_no": 3,
   "source": "11_卷下_词讼第九.xhtml#条8#段3",
   "text": "倘粮数不清，典卖不明者，年远不与准理。",
   "offset": {
    "start": 29,
    "end": 48
   }
  },
  {
   "seg_id": "11-009-01",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 9,
   "seg_no": 1,
   "source": "11_卷下_词讼第九.xhtml#条9#段1",
   "text": "告户婚田土等事，每十日一放告。",
   "offset": {
    "start": 0,
    "end": 15
   }
  },
  {
   "seg_id": "11-009-02",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 9,
   "seg_no": 2,
   "source": "11_卷下_词讼第九.xhtml#条9#段2",
   "text": "若斗殴人命奸盗，每日放告。",
   "offset": {
    "start": 15,
    "end": 28
   }
  },
  {
   "seg_id": "11-010-01",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 10,
   "seg_no": 1,
   "source": "11_卷下_词讼第九.xhtml#条10#段1",
   "text": "妇人告状并犯罪，不可近前审问，亦不可纵容手下人凌辱恐吓。",
   "offset": {
    "start": 0,
    "end": 28
   }
  },
  {
   "seg_id": "11-011-01",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 11,
   "seg_no": 1,
   "source": "11_卷下_词讼第九.xhtml#条11#段1",
   "text": "有词讼应理者，量拘紧关人犯，多则三四人，少则二人。",
   "offset": {
    "start": 0,
    "end": 25
   }
  },
  {
   "seg_id": "11-011-02",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 11,
   "seg_no": 2,
   "source": "11_卷下_词讼第九.xhtml#条11#段2",
   "text": "责审口词相同，即将干证人先省回家，不可将老幼及妇女一概监提，不许照名罚赎。",
   "offset": {
    "start": 25,
    "end": 62
   }
  },
  {
   "seg_id": "11-012-01",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 12,
   "seg_no": 1,
   "source": "11_卷下_词讼第九.xhtml#条12#段1",
   "text": "里老承办词讼，如有事情难豁者，即带干证紧关二三人。",
   "offset": {
    "start": 0,
    "end": 25
   }
  },
  {
   "seg_id": "11-012-02",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 12,
   "seg_no": 2,
   "source": "11_卷下_词讼第九.xhtml#条12#段2",
   "text": "如情轻，判理明白及自息和者，止将缘由每月于朔望日辰时引缴，余日不准，可免拘留人众。",
   "offset": {
    "start": 25,
    "end": 66
   }
  },
  {
   "seg_id": "11-013-01",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 13,
   "seg_no": 1,
   "source": "11_卷下_词讼第九.xhtml#条13#段1",
   "text": "凡拘摄次，量地方远近，人犯多寡，以定日期，发牌拘唤，不可凭吏妄听举行。",
   "offset": {
    "start": 0,
    "end": 35
   }
  },
  {
   "seg_id": "11-013-02",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 13,
   "seg_no": 2,
   "source": "11_卷下_词讼第九.xhtml#条13#段2",
   "text": "如有要紧重犯，另置木牌十面挂于后堂。",
   "offset": {
    "start": 35,
    "end": 53
   }
  },
  {
   "seg_id": "11-013-03",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 13,
   "seg_no": 3,
   "source": "11_卷下_词讼第九.xhtml#条13#段3",
   "text": "遇要行拿，亲笔出名于上，密差应捕，刻期捉获，不容皂隶等押带囚犯出外召保。",
   "offset": {
    "start": 53,
    "end": 89
   }
  },
  {
   "seg_id": "11-014-01",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 14,
   "seg_no": 1,
   "source": "11_卷下_词讼第九.xhtml#条14#段1",
   "text": "凡遇海行事件及轻省词讼，须开写告示，立定限期，准自投到。",
   "offset": {
    "start": 0,
    "end": 28
   }
  },
  {
   "seg_id": "11-014-02",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 14,
   "seg_no": 2,
   "source": "11_卷下_词讼第九.xhtml#条14#段2",
   "text": "如有监人命差，委里老应捕拘促，情愿不服，应申照律施行。",
   "offset": {
    "start": 28,
    "end": 55
   }
  },
  {
   "seg_id": "11-014-03",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 14,
   "seg_no": 3,
   "source": "11_卷下_词讼第九.xhtml#条14#段3",
   "text": "如争情可处者，且从宽，如着犯有力亲属缉捕，切不可滥差，添皂隶人等。",
   "offset": {
    "start": 55,
    "end": 88
   }
  },
  {
   "seg_id": "11-015-01",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 15,
   "seg_no": 1,
   "source": "11_卷下_词讼第九.xhtml#条15#段1",
   "text": "遇权毫势要须当，平日易气处之。",
   "offset": {
    "start": 0,
    "end": 15
   }
  },
  {
   "seg_id": "11-015-02",
   "chapter_no": "11",
   "chapter": "卷下_词讼第九",
   "item": 15,
   "seg_no": 2,
   "source": "11_卷下_词讼第九.xhtml#条15#段2",
   "text": "不可受其笼络挟制，亦不可故意窘辱，自立门户。",
   "offset": {
    "start": 15,
    "end": 37
   }
  }
 ]
}