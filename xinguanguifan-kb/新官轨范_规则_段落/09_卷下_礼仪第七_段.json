{
 "schema_version": "kg-seg-json-v1",
 "volume": "09",
 "chapter": "卷下_礼仪第七",
 "source_file": "09_卷下_礼仪第七.xhtml",
 "item_count": 18,
 "segment_count": 28,
 "segments": [
  {
   "seg_id": "09-001-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 1,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条1#段1",
   "text": "文公家礼颁降之书，其尸棺暴露，火作斋醮，俱律法所禁，须省谕里老各要遵奉。",
   "offset": {
    "start": 0,
    "end": 36
   }
  },
  {
   "seg_id": "09-002-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 2,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条2#段1",
   "text": "习仪拜牌，定礼生分投监，不许分外生事。",
   "offset": {
    "start": 0,
    "end": 19
   }
  },
  {
   "seg_id": "09-002-02",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 2,
   "seg_no": 2,
   "source": "09_卷下_礼仪第七.xhtml#条2#段2",
   "text": "如礼生不循礼，先后不齐者，先责礼房该吏。",
   "offset": {
    "start": 19,
    "end": 39
   }
  },
  {
   "seg_id": "09-003-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 3,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条3#段1",
   "text": "救护须告示僚属，拘集僧道至期行礼。",
   "offset": {
    "start": 0,
    "end": 17
   }
  },
  {
   "seg_id": "09-003-02",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 3,
   "seg_no": 2,
   "source": "09_卷下_礼仪第七.xhtml#条3#段2",
   "text": "仍令地方总甲巡视，莫容闲人喧哗。",
   "offset": {
    "start": 17,
    "end": 33
   }
  },
  {
   "seg_id": "09-004-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 4,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条4#段1",
   "text": "遇习仪拜牌救护等项，有乡宦位高者，令该里长请报官，小者告示知悉，务查点齐集行礼。",
   "offset": {
    "start": 0,
    "end": 40
   }
  },
  {
   "seg_id": "09-005-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 5,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条5#段1",
   "text": "迎春乃百姓乐事，宜从容为之。",
   "offset": {
    "start": 0,
    "end": 14
   }
  },
  {
   "seg_id": "09-005-02",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 5,
   "seg_no": 2,
   "source": "09_卷下_礼仪第七.xhtml#条5#段2",
   "text": "其春花、春杖，所费不多，不可分派里甲。",
   "offset": {
    "start": 14,
    "end": 33
   }
  },
  {
   "seg_id": "09-006-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 6,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条6#段1",
   "text": "乡属乡饮酒，须令教读掌礼毕日回话。",
   "offset": {
    "start": 0,
    "end": 17
   }
  },
  {
   "seg_id": "09-007-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 7,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条7#段1",
   "text": "凡遇祭祀，先期查照旧案价值支钱，与牙行收买牲口等项，完算以备公用。",
   "offset": {
    "start": 0,
    "end": 33
   }
  },
  {
   "seg_id": "09-007-02",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 7,
   "seg_no": 2,
   "source": "09_卷下_礼仪第七.xhtml#条7#段2",
   "text": "不可逼勒赊买及容情贵买。",
   "offset": {
    "start": 33,
    "end": 45
   }
  },
  {
   "seg_id": "09-008-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 8,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条8#段1",
   "text": "祭坛令所属僧道分坛诵经，自朝至暮，祭毕分与羹饮。",
   "offset": {
    "start": 0,
    "end": 24
   }
  },
  {
   "seg_id": "09-009-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 9,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条9#段1",
   "text": "祭神庙赛，小处则当禁止，大处人众不可遏者，须与会赛日差人检朿，收其香钱公用，勿容会首克落。",
   "offset": {
    "start": 0,
    "end": 45
   }
  },
  {
   "seg_id": "09-010-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 10,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条10#段1",
   "text": "淫祠不必悉行拆毁，须量地方改为公廨社学等项。",
   "offset": {
    "start": 0,
    "end": 22
   }
  },
  {
   "seg_id": "09-011-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 11,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条11#段1",
   "text": "禁僧不许纵容妇人入寺烧香、听讲经会。",
   "offset": {
    "start": 0,
    "end": 18
   }
  },
  {
   "seg_id": "09-011-02",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 11,
   "seg_no": 2,
   "source": "09_卷下_礼仪第七.xhtml#条11#段2",
   "text": "先须省谕地方禁约，如违，先将地方问罪。",
   "offset": {
    "start": 18,
    "end": 37
   }
  },
  {
   "seg_id": "09-012-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 12,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条12#段1",
   "text": "义夫、节妇、孝子、顺孙，须自密访，的实着实举保。",
   "offset": {
    "start": 0,
    "end": 24
   }
  },
  {
   "seg_id": "09-012-02",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 12,
   "seg_no": 2,
   "source": "09_卷下_礼仪第七.xhtml#条12#段2",
   "text": "若里老呈报及乡宦保者，不实不可保举。",
   "offset": {
    "start": 24,
    "end": 42
   }
  },
  {
   "seg_id": "09-013-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 13,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条13#段1",
   "text": "凡学校生儒，须遵上司案验季考，朔望抽签讲论。",
   "offset": {
    "start": 0,
    "end": 22
   }
  },
  {
   "seg_id": "09-013-02",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 13,
   "seg_no": 2,
   "source": "09_卷下_礼仪第七.xhtml#条13#段2",
   "text": "如有不到，仰令该吏附卷施行。",
   "offset": {
    "start": 22,
    "end": 36
   }
  },
  {
   "seg_id": "09-014-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 14,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条14#段1",
   "text": "生员乡宦之家，遇编差役均徭，先取本家实在事产，免致临期告扰。",
   "offset": {
    "start": 0,
    "end": 30
   }
  },
  {
   "seg_id": "09-014-02",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 14,
   "seg_no": 2,
   "source": "09_卷下_礼仪第七.xhtml#条14#段2",
   "text": "每人将应免供丁，责令里书开写一帖，付之以为执照。",
   "offset": {
    "start": 30,
    "end": 54
   }
  },
  {
   "seg_id": "09-015-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 15,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条15#段1",
   "text": "乡宦不论存亡、高下、贫富，与些小事情，亦宜宽待，遇有凶吉，须自尽礼。",
   "offset": {
    "start": 0,
    "end": 34
   }
  },
  {
   "seg_id": "09-016-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 16,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条16#段1",
   "text": "乡饮须自访实敦请，近县者自请，各乡遣礼生致请，不许省祭生员混坐寓到。",
   "offset": {
    "start": 0,
    "end": 34
   }
  },
  {
   "seg_id": "09-016-02",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 16,
   "seg_no": 2,
   "source": "09_卷下_礼仪第七.xhtml#条16#段2",
   "text": "将晏之先，令具仪注呈看，即饮之后，候收完器皿，撤去桌椅方散。",
   "offset": {
    "start": 34,
    "end": 64
   }
  },
  {
   "seg_id": "09-017-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 17,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条17#段1",
   "text": "遇祭祀斋戒，不许粮里人等置酒办饭。",
   "offset": {
    "start": 0,
    "end": 17
   }
  },
  {
   "seg_id": "09-017-02",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 17,
   "seg_no": 2,
   "source": "09_卷下_礼仪第七.xhtml#条17#段2",
   "text": "临祭，须自巡视祭品，亦先要仪注呈看。",
   "offset": {
    "start": 17,
    "end": 35
   }
  },
  {
   "seg_id": "09-018-01",
   "chapter_no": "09",
   "chapter": "卷下_礼仪第七",
   "item": 18,
   "seg_no": 1,
   "source": "09_卷下_礼仪第七.xhtml#条18#段1",
   "text": "季考生员，当问境内民情土俗，兴利除害之策，使人各得尽请，愈于询访。",
   "offset": {
    "start": 0,
    "end": 33
   }
  }
 ]
}